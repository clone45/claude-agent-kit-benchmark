+// ── Rng ──────────────────────────────────────────────────────────────────────
+//
+// xorshift32, for the per-step chance. Never zero: zero is a fixed point, so
+// seed(0) falls back to the default state.
+//
+struct Rng
+{
+    uint32_t state;
+
+    Rng() : state(0x9E3779B9u) {}
+
+    void seed(uint32_t s) { state = s ? s : 0x9E3779B9u; }
+
+    uint32_t next()
+    {
+        uint32_t x = state;
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        state = x;
+        return x;
+    }
+
+    // 0..99
+    int percent() { return (int)(next() % 100); }
+};
