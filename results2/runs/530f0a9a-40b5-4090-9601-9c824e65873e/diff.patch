+// ── ACCENT: every Nth hit ────────────────────────────────────────────────────
+
+// Drive `n` accepted clocks one sample apart from a settled rig and record,
+// per hit (in order), whether it was accented. Also checks that `accent` is
+// never true on a sample without `struck`. Returns the number of hits.
+static int clockHits(Rig& r, int n, bool* accented, int cap, bool& accent_without_strike)
+{
+    int hits = 0;
+    for (int i = 0; i < n; i++)
+    {
+        Out o = r.clock();
+        if (o.accent && !o.struck) accent_without_strike = true;
+        if (o.struck)
+        {
+            if (hits < cap) accented[hits] = o.accent;
+            hits++;
+        }
+        o = r.idle();
+        if (o.accent || o.struck) accent_without_strike = true;
+    }
+    return hits;
+}
