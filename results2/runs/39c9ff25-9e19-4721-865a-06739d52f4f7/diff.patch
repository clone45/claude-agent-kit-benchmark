+// ── Rng ──────────────────────────────────────────────────────────────────────
+//
+// xorshift32 (Marsaglia's 13 / 17 / 5). The state is never 0, the one value
+// xorshift cannot leave: seed(0) stores the default instead.
+//
+struct Rng
+{
+    uint32_t state;
+
+    Rng() : state(0x9E3779B9u) {}
+
+    void seed(uint32_t s)
+    {
+        state = s ? s : 0x9E3779B9u;
+    }
+
+    uint32_t next()
+    {
+        uint32_t x = state;
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        state = x;
+        return x;
+    }
+
+    // 0..99.
+    int percent()
+    {
+        return (int)(next() % 100);
+    }
+};
+
