diff --git a/tests/vx_drum_sequencer/direction_test.cpp b/tests/vx_drum_sequencer/direction_test.cpp
new file mode 100644
index 0000000..e489421
--- /dev/null
+++ b/tests/vx_drum_sequencer/direction_test.cpp
@@ -0,0 +1,246 @@
+// VX Drum Sequencer engine: playback direction. Playhead::advance in FORWARD,
+// BACKWARD and PENDULUM, the hand-off (-1) and a shrunken length in each, the
+// reset rule (step 1 current, PENDULUM moves forward next), and
+// Sequencer::setDirection / direction() with a clocked run end to end.
+//
+//   g++ -std=c++11 -O2 -I ../../src/modules/VXDrumSequencer -o direction_test direction_test.cpp && ./direction_test
+
+#include "VXDrumSequencerEngine.hpp"
+#include "check.hpp"
+
+using namespace vx_drum_sequencer;
+
+static const float SR = 48000.f;
+static const int WINDOW = 48;    // vgLib_v2::ResetClockWindow::samplesFor(48000)
+
+static float OUT[LANES];
+
+// Advance `n` times at `length`, checking each result against `want`.
+static void expectRun(const char* what, Playhead& p, int length, const int* want, int n)
+{
+    char label[160];
+    for (int i = 0; i < n; i++)
+    {
+        std::snprintf(label, sizeof label, "%s, advance %d", what, i + 1);
+        checkEq(label, p.advance(length), want[i]);
+    }
+}
+
+static void forwardTests()
+{
+    std::printf("FORWARD\n");
+    Playhead p;
+    checkEq("the default direction is FORWARD", p.direction, FORWARD);
+    const int want[] = { 1, 2, 3, 0, 1 };
+    expectRun("length 4 from step 1", p, 4, want, 5);
+    p.position = 7;
+    checkEq("a length that shrank below the position wraps to step 1", p.advance(4), 0);
+    p.position = 4;
+    checkEq("a position equal to the length wraps to step 1", p.advance(4), 0);
+    p.rewind();
+    checkEq("the hand-off lands on step 1", p.advance(4), 0);
+    checkEq("then step 2", p.advance(4), 1);
+    checkEq("length 1 always plays step 1", p.advance(1), 0);
+    checkEq("length above STEPS is clamped", (p.position = STEPS - 1, p.advance(STEPS + 5)), 0);
+    checkEq("length 0 is clamped to 1", p.advance(0), 0);
+}
+
+static void backwardTests()
+{
+    std::printf("BACKWARD\n");
+    Playhead p;
+    p.direction = BACKWARD;
+    const int want[] = { 3, 2, 1, 0, 3, 2 };
+    expectRun("length 4 from step 1", p, 4, want, 6);
+    p.position = 7;
+    checkEq("a length that shrank below the position goes to the last step", p.advance(4), 3);
+    p.position = 4;
+    checkEq("a position equal to the length goes to the last step", p.advance(4), 3);
+    p.rewind();
+    checkEq("the hand-off lands on step 1", p.advance(4), 0);
+    checkEq("then wraps to the last step", p.advance(4), 3);
+    p.position = 0;
+    checkEq("length 1 always plays step 1", p.advance(1), 0);
+    checkEq("length 1 again", p.advance(1), 0);
+    p.position = 0;
+    checkEq("length above STEPS is clamped: wraps to step 16", p.advance(STEPS + 5), STEPS - 1);
+    p.position = 0;
+    checkEq("length 0 is clamped to 1", p.advance(0), 0);
+    p.position = 3;
+    p.reset();
+    checkEq("reset puts step 1 current", p.position, 0);
+    checkEq("and the next move wraps to the last step", p.advance(4), 3);
+}
+
+static void pendulumTests()
+{
+    std::printf("PENDULUM\n");
+    {
+        Playhead p;
+        p.direction = PENDULUM;
+        const int want[] = { 1, 2, 3, 2, 1, 0, 1, 2, 3, 2, 1, 0, 1 };
+        expectRun("length 4 from step 1, ends not repeated", p, 4, want, 13);
+    }
+    {
+        Playhead p;
+        p.direction = PENDULUM;
+        const int want[] = { 1, 0, 1, 0, 1 };
+        expectRun("length 2 alternates", p, 2, want, 5);
+    }
+    {
+        Playhead p;
+        p.direction = PENDULUM;
+        const int want[] = { 0, 0, 0, 0 };
+        expectRun("length 1 always plays step 1", p, 1, want, 4);
+        const int after[] = { 1, 2, 1, 0 };
+        expectRun("then length 3 carries on forward", p, 3, after, 4);
+    }
+    {
+        Playhead p;
+        p.direction = PENDULUM;
+        p.position = 7;
+        checkEq("a length that shrank below the position goes to the last step", p.advance(4), 3);
+        checkEq("and the next move is backward", p.advance(4), 2);
+        checkEq("still backward", p.advance(4), 1);
+    }
+    {
+        Playhead p;
+        p.direction = PENDULUM;
+        p.position = 4;
+        checkEq("a position equal to the length goes to the last step", p.advance(4), 3);
+        checkEq("and the next move is backward", p.advance(4), 2);
+    }
+    {
+        // Shrink while heading backward from above the new length.
+        Playhead p;
+        p.direction = PENDULUM;
+        const int up[] = { 1, 2, 3, 4, 5, 6, 7, 6 };
+        expectRun("length 8 up and turning", p, 8, up, 8);
+        checkEq("shrink to 4 while heading back: the last step", p.advance(4), 3);
+        checkEq("then backward", p.advance(4), 2);
+    }
+    {
+        // A length that shrinks to exactly position + 1 turns the playhead.
+        Playhead p;
+        p.direction = PENDULUM;
+        p.position = 3;
+        checkEq("on the new last step heading forward: turns back", p.advance(4), 2);
+    }
+    {
+        Playhead p;
+        p.direction = PENDULUM;
+        const int down[] = { 1, 2, 3, 2 };
+        expectRun("length 4 into the backward half", p, 4, down, 4);
+        p.rewind();
+        checkEq("the hand-off lands on step 1", p.advance(4), 0);
+        checkEq("and the next move is forward", p.advance(4), 1);
+        checkEq("still forward", p.advance(4), 2);
+    }
+    {
+        Playhead p;
+        p.direction = PENDULUM;
+        const int down[] = { 1, 2, 3, 2 };
+        expectRun("length 4 into the backward half", p, 4, down, 4);
+        p.reset();
+        checkEq("reset puts step 1 current", p.position, 0);
+        checkEq("and the next move is forward", p.advance(4), 1);
+        checkEq("still forward", p.advance(4), 2);
+    }
+    {
+        Playhead p;
+        p.direction = PENDULUM;
+        p.advance(4);
+        p.advance(4);
+        p.advance(4);
+        p.advance(4);                // 1 2 3 2: heading back
+        p.rewind();
+        checkEq("rewind() still parks at -1", p.position, -1);
+    }
+    {
+        Playhead p;
+        p.direction = PENDULUM;
+        checkEq("length above STEPS is clamped: 16 then turns", (p.position = STEPS - 1, p.advance(STEPS + 5)), STEPS - 2);
+    }
+}
+
+static void sequencerTests()
+{
+    std::printf("Sequencer direction\n");
+    Sequencer s;
+    checkEq("the default direction is FORWARD", s.direction(), FORWARD);
+    s.setDirection(BACKWARD);
+    checkEq("BACKWARD is stored", s.direction(), BACKWARD);
+    checkEq("on the playhead", s.head.direction, BACKWARD);
+    s.setDirection(PENDULUM);
+    checkEq("PENDULUM is stored", s.direction(), PENDULUM);
+    s.setDirection(3);
+    checkEq("3 is FORWARD", s.direction(), FORWARD);
+    s.setDirection(PENDULUM);
+    s.setDirection(-1);
+    checkEq("-1 is FORWARD", s.direction(), FORWARD);
+    s.setDirection(1000);
+    checkEq("1000 is FORWARD", s.direction(), FORWARD);
+
+    // End to end: clocked steps through process(), well clear of the window.
+    Memory m;
+    m.length = 4;
+    PlaySource src; src.memory = &m; src.mute = 0;
+    const int GAP = 200;
+
+    struct Case { int dir; int want[8]; const char* what; };
+    const Case cases[] = {
+        { FORWARD,  { 1, 2, 3, 0, 1, 2, 3, 0 }, "FORWARD clocks" },
+        { BACKWARD, { 3, 2, 1, 0, 3, 2, 1, 0 }, "BACKWARD clocks" },
+        { PENDULUM, { 1, 2, 3, 2, 1, 0, 1, 2 }, "PENDULUM clocks" },
+    };
+    char label[160];
+    for (const Case& c : cases)
+    {
+        Sequencer q;
+        q.setDirection(c.dir);
+        q.rewind(WINDOW);            // load: an implicit reset
+        for (int k = 0; k < 8; k++)
+        {
+            for (int i = 0; i < GAP; i++) q.process(false, src, SR, 48, OUT);
+            q.process(true, src, SR, 48, OUT);
+            std::snprintf(label, sizeof label, "%s, clock %d", c.what, k + 1);
+            checkEq(label, q.report.position, c.want[k]);
+        }
+    }
+
+    // A reset in PENDULUM plays step 1 and the next clock moves forward.
+    Sequencer q;
+    q.setDirection(PENDULUM);
+    q.rewind(WINDOW);
+    for (int k = 0; k < 4; k++)      // 1 2 3 2: heading back
+    {
+        for (int i = 0; i < GAP; i++) q.process(false, src, SR, 48, OUT);
+        q.process(true, src, SR, 48, OUT);
+    }
+    checkEq("PENDULUM heading back on step 3", q.report.position, 2);
+    q.reset(src, WINDOW);
+    q.process(false, src, SR, 48, OUT);
+    checkEq("a reset plays step 1", q.report.position, 0);
+    check("and fired", q.fired_this_sample);
+    for (int i = 0; i < GAP; i++) q.process(false, src, SR, 48, OUT);
+    q.process(true, src, SR, 48, OUT);
+    checkEq("the next clock moves forward to step 2", q.report.position, 1);
+
+    // The hand-off in PENDULUM: step 1 on the next clock, then forward.
+    q.handOff();
+    for (int i = 0; i < GAP; i++) q.process(false, src, SR, 48, OUT);
+    q.process(true, src, SR, 48, OUT);
+    checkEq("after a hand-off the next clock plays step 1", q.report.position, 0);
+    for (int i = 0; i < GAP; i++) q.process(false, src, SR, 48, OUT);
+    q.process(true, src, SR, 48, OUT);
+    checkEq("then step 2", q.report.position, 1);
+}
+
+int main()
+{
+    forwardTests();
+    backwardTests();
+    pendulumTests();
+    sequencerTests();
+    return finish("direction_test");
+}
