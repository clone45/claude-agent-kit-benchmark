+static void accentEverySecondTests()
+{
+    std::printf("accent: 2 accents the second, fourth, sixth hit\n");
+    Rig r(16, 16, 0);
+    r.seq.accent_every = 2;
+    r.settle();
+    std::string struck, accent;
+    clockPattern(r, 8, struck, accent);
+    checkStr("every clock strikes (16/16)", struck, "xxxxxxxx");
+    checkStr("hits 2, 4, 6, 8 are accented", accent, ".x.x.x.x");
+
+    // Counted in hits, not steps: rests in between do not count.
+    Rig e(5, 8, 0);                          // x.x.xx.x
+    e.seq.accent_every = 2;
+    e.settle();
+    clockPattern(e, 16, struck, accent);
+    checkStr("(E(5,8) from step 2)", struck, ".x.xx.xx.x.xx.xx");
+    checkStr("every second HIT, across the rests", accent, "...x..x..x..x..x");
+
+    // Every third, and the largest N.
+    Rig t(16, 16, 0);
+    t.seq.accent_every = 3;
+    t.settle();
+    clockPattern(t, 9, struck, accent);
+    checkStr("3: hits 3, 6, 9", accent, "..x..x..x");
+    Rig g(16, 16, 0);
+    g.seq.accent_every = 8;
+    g.settle();
+    clockPattern(g, 17, struck, accent);
+    checkStr("8: hits 8 and 16", accent, ".......x.......x.");
+
+    // Changing N while running keeps the count.
+    Rig c(16, 16, 0);
+    c.seq.accent_every = 2;
+    c.settle();
+    clockPattern(c, 3, struck, accent);      // hits 1..3
+    checkEq("(three hits counted)", c.seq.hits_struck, 3);
+    c.seq.accent_every = 4;
+    clockPattern(c, 5, struck, accent);      // hits 4..8
+    checkStr("a change of N keeps the count: hits 4 and 8 under N 4", accent, "x...x");
+    c.seq.accent_every = 0;
+    clockPattern(c, 2, struck, accent);      // hits 9, 10
+    c.seq.accent_every = 11;                 // clamps to 8
+    clockPattern(c, 6, struck, accent);      // hits 11..16
+    checkStr("turning it off and back on keeps the count too (16 is a multiple of 8)", accent, ".....x");
+
+    // A lost chance roll is not struck and is not counted.
+    const uint32_t seed = 0x2468ACE1u;
+    ChanceRig ch(16, 16, 0, 50);
+    ch.seq.rng.seed(seed);
+    ch.seq.accent_every = 2;
+    ch.settle();
+    int counted = 0;
+    bool every_second = true;
+    for (int i = 0; i < 200; i++)
+    {
+        Out o = ch.clock();
+        if (o.struck) counted++;
+        if (o.accent != (o.struck && counted % 2 == 0)) every_second = false;
+        if (!o.struck && o.accent) every_second = false;
+    }
+    check("with chance, only the hits that play are counted", every_second);
+    checkEq("the counter equals the strikes that played", ch.seq.hits_struck, counted);
+    check("(some rolls lost)", counted < 200 && counted > 0);
+}
