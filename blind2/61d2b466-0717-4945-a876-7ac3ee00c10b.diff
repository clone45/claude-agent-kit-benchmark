+static void accentResetTests()
+{
+    std::printf("accent: load and reset zero the count\n");
+    Rig r(16, 16, 0);
+    r.seq.accent_every = 2;
+    r.settle();
+    std::string struck, accent;
+    clockPattern(r, 3, struck, accent);      // hits 1..3: the next would be accented
+    checkEq("(three hits counted)", r.seq.hits_struck, 3);
+
+    Out o = r.reset();
+    check("a reset that plays step 1 strikes", o.struck);
+    checkEq("and that strike is hit number 1", r.seq.hits_struck, 1);
+    check("so under N 2 it is not accented", !o.accent);
+    r.idleFor(W - 1);
+    clockPattern(r, 4, struck, accent);      // hits 2..5
+    checkStr("counting resumes from the reset: hits 2 and 4 accented", accent, "x.x.");
+
+    // Under N 1 the reset's strike is accented: it is hit 1.
+    Rig one(16, 16, 0);
+    one.seq.accent_every = 1;
+    one.settle();
+    one.clocks(5);
+    o = one.reset();
+    check("N 1: the reset's strike is accented", o.struck && o.accent);
+
+    // A same-sample reset and clock: one strike, hit number 1.
+    Rig b(16, 16, 0);
+    b.seq.accent_every = 2;
+    b.settle();
+    b.clocks(5);
+    o = b.both();
+    checkEq("same-sample reset + clock counts one hit", b.seq.hits_struck, 1);
+    check("(not accented under N 2)", !o.accent);
+
+    // A reset onto a rest zeroes the count and counts nothing.
+    Rig rest(1, 4, 1);                       // x... rotated by 1: ...x, step 1 a rest
+    rest.seq.accent_every = 1;
+    rest.settle();
+    rest.clocks(8);                          // two passes: two hits
+    checkEq("(two hits counted)", rest.seq.hits_struck, 2);
+    o = rest.reset();
+    check("a reset onto a rest strikes nothing", !o.struck && !o.accent);
+    checkEq("and zeroes the count", rest.seq.hits_struck, 0);
+
+    // A reset whose own chance roll loses zeroes the count, counts nothing.
+    ChanceRig z(16, 16, 0, 0);
+    z.seq.accent_every = 1;
+    z.settle();
+    z.clock();
+    o = z.reset();
+    check("a reset at chance 0 neither strikes nor accents", !o.struck && !o.accent);
+    checkEq("(nothing counted)", z.seq.hits_struck, 0);
+
+    // load() zeroes the count, and is not itself a strike.
+    Rig l(16, 16, 0);
+    l.seq.accent_every = 2;
+    l.settle();
+    l.clocks(3);
+    l.seq.load(W);
+    checkEq("load zeroes the count", l.seq.hits_struck, 0);
+    o = l.idle();
+    check("load strikes and accents nothing", !o.struck && !o.accent);
+    l.settle();
+    clockPattern(l, 2, struck, accent);
+    checkStr("after load, the second hit is the first accent", accent, ".x");
+}
