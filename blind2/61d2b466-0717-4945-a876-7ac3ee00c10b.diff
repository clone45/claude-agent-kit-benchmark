+
+// `n` accepted clocks one sample apart from a settled Rig, recording which
+// were struck and which accented as strings of 'x' / '.' (one char per clock).
+static void clockPattern(Rig& r, int n, std::string& struck, std::string& accent)
+{
+    struck.clear();
+    accent.clear();
+    for (int i = 0; i < n; i++)
+    {
+        Out o = r.clock();
+        struck += o.struck ? 'x' : '.';
+        accent += o.accent ? 'x' : '.';
+    }
