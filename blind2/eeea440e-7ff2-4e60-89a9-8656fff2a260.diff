+// ── Rng ──────────────────────────────────────────────────────────────────────
+//
+// xorshift32 (Marsaglia's 13 / 17 / 5), the chance roll's generator. State 0
+// is xorshift's fixed point, so seed(0) falls back to the default state.
+//
+struct Rng
+{
+    uint32_t state;
+
+    Rng() : state(0x9E3779B9u) {}
+
+    void seed(uint32_t s) { state = s ? s : 0x9E3779B9u; }
+
+    uint32_t next()
+    {
+        uint32_t x = state;
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        state = x;
+        return x;
+    }
+
+    // 0..99. The modulo bias (about 1 part in 43 million) is irrelevant here.
+    int percent() { return (int)(next() % 100u); }
+};
+
