+// ── Chance ───────────────────────────────────────────────────────────────────
+
+// One sample at a given chance, with the Rig's knobs.
+static Out at(Rig& r, bool reset, bool clock, int chance)
+{
+    return r.seq.process(reset, clock, r.window, r.hits, r.steps, r.rot, chance);
+}
+
+static bool sameOut(const Out& a, const Out& b)
+{
+    return a.gate == b.gate && a.struck == b.struck && a.gate_gap == b.gate_gap && a.position == b.position;
+}
+
+// A deterministic stimulus: resets and clocks at irregular spacing, some
+// inside the window, some together. Returns (reset, clock) for sample i.
+static void stimulus(Rng& g, bool& reset, bool& clock)
+{
+    uint32_t v = g.next();
+    reset = (v % 997) == 0;
+    clock = (v % 13) == 0;
+}
+
+static void rngTests()
+{
+    std::printf("Rng\n");
+    Rng g;
+    checkEq("Rng starts at 0x9E3779B9", (long long)g.state, 0x9E3779B9LL);
+    checkEq("first next() is xorshift32(0x9E3779B9)", (long long)g.next(), 0x510C4619LL);
+    checkEq("next() stores its result", (long long)g.state, 0x510C4619LL);
+    checkEq("percent() is next() % 100", g.percent(), (long long)(0xE02E553Eu % 100u));
+    g.seed(1);
+    checkEq("seed(1) stores 1", (long long)g.state, 1);
+    checkEq("xorshift32(1) is 270369", (long long)g.next(), 270369);
+    g.seed(0);
+    checkEq("seed(0) falls back to 0x9E3779B9", (long long)g.state, 0x9E3779B9LL);
+    Sequencer seq;
+    checkEq("a Sequencer's rng starts at 0x9E3779B9", (long long)seq.rng.state, 0x9E3779B9LL);
+}
+
+static void sixArgumentTests()
+{
+    std::printf("the six-argument process is chance 100\n");
+    // Same stimulus into three sequencers: six-argument, chance 100 and an
+    // out-of-range chance 150 (clamped to 100). Mixed patterns, a STEPS change
+    // midway, resets and clocks together and inside the window.
+    Rig a(5, 8, 0), b(5, 8, 0), c(5, 8, 0);
+    Rng g;
+    g.seed(12345);
+    bool same = true;
+    int strikes = 0;
+    for (int i = 0; i < 20000; i++)
+    {
+        if (i == 10000) { a.steps = b.steps = c.steps = 13; a.rot = b.rot = c.rot = 3; }
+        bool reset, clock;
+        stimulus(g, reset, clock);
+        Out oa = a.seq.process(reset, clock, a.window, a.hits, a.steps, a.rot);
+        Out ob = at(b, reset, clock, 100);
+        Out oc = at(c, reset, clock, 150);
+        if (!sameOut(oa, ob) || !sameOut(oa, oc)) same = false;
+        if (oa.struck) strikes++;
+    }
+    check("six-argument, chance 100 and chance 150 agree on every sample", same);
+    check("(and the stimulus struck hits)", strikes > 100);
+    checkEq("the six-argument form never touches the generator", (long long)a.seq.rng.state, 0x9E3779B9LL);
+    checkEq("chance 100 never touches the generator", (long long)b.seq.rng.state, 0x9E3779B9LL);
+    checkEq("chance 150 never touches the generator", (long long)c.seq.rng.state, 0x9E3779B9LL);
+
+    // The documented cases still hold at chance 100: a reset strikes step 1.
+    Rig d(4, 16, 0);
+    d.settle();
+    d.clocks(3);
+    Out o = at(d, true, false, 100);
+    check("a reset at chance 100 strikes step 1", o.struck && o.gate && o.position == 0);
+}
+
+static void chanceZeroTests()
+{
+    std::printf("chance 0\n");
+    Rig r(16, 16, 0);
+    Out o = at(r, false, false, 0);
+    check("load does not roll: step 1's GATE is high at chance 0", o.gate && !o.struck);
+    r.idleFor(W);
+
+    bool anyGate = false, anyStrike = false;
+    for (int i = 0; i < 40; i++)
+    {
+        o = at(r, false, true, 0);
+        anyGate = anyGate || o.gate;
+        anyStrike = anyStrike || o.struck;
+        for (int j = 0; j < 10; j++) { o = at(r, false, false, 0); anyGate = anyGate || o.gate; }
+    }
+    check("40 clocks onto hits at chance 0 strike nothing", !anyStrike);
+    check("and GATE stays low throughout", !anyGate);
+    checkEq("the playhead still advances", r.seq.position, 40 % 16);
+
+    o = at(r, true, false, 0);
+    check("a reset at chance 0 does not strike step 1", !o.struck && !o.gate && o.position == 0);
+    check("and reports no gap (GATE was already low)", !o.gate_gap);
+
+    Rig n(16, 16, 0);
+    n.settle();
+    o = at(n, false, true, -7);
+    check("a negative chance clamps to 0", !o.struck && !o.gate && o.position == 1);
+    checkEq("chance 0 never touches the generator", (long long)r.seq.rng.state, 0x9E3779B9LL);
+    checkEq("(nor does a negative chance)", (long long)n.seq.rng.state, 0x9E3779B9LL);
+
+    // The pattern table itself is untouched.
+    check("the pattern is still all hits", r.seq.pattern.count() == 16);
+
+    // Back to 100: the next clock after the reset's window plays.
+    for (int i = 0; i < W; i++) at(r, false, false, 0);
+    o = at(r, false, true, 100);
+    check("chance back at 100: the next clock strikes", o.struck && o.gate);
+}
+
+static void determinismTests()
+{
+    std::printf("chance is deterministic for a seeded generator\n");
+    // Two sequencers, same seed, same stimulus: identical output.
+    Rig a(5, 8, 0), b(5, 8, 0);
+    a.seq.rng.seed(777);
+    b.seq.rng.seed(777);
+    Rng g;
+    g.seed(4242);
+    bool same = true;
+    for (int i = 0; i < 20000; i++)
+    {
+        bool reset, clock;
+        stimulus(g, reset, clock);
+        if (!sameOut(at(a, reset, clock, 50), at(b, reset, clock, 50))) same = false;
+    }
+    check("same seed, same edges: same output on every sample", same);
+
+    // Against a model: one percent() per landing on a hit, none for a rest
+    // and none on idle samples. E(5,8) = x.x.xx.x, so rests are landed on too.
+    Rig r(5, 8, 0);
+    r.seq.rng.seed(99);
+    Rng model;
+    model.seed(99);
+    r.settle();
+    int played = 0, skippedHits = 0, rests = 0;
+    bool agrees = true, gateHolds = true;
+    for (int i = 0; i < 400; i++)
+    {
+        Out o = at(r, false, true, 30);
+        bool hit = r.seq.pattern.hit[o.position];
+        bool plays = hit && model.percent() < 30;
+        if (o.struck != plays || o.gate != plays) agrees = false;
+        if (plays) played++;
+        else if (hit) skippedHits++;
+        else rests++;
+        for (int j = 0; j < 5; j++)
+        {
+            Out q = at(r, false, false, 30);
+            if (q.gate != plays || q.struck) gateHolds = false;
+        }
+    }
+    check("each landing matches the model's roll", agrees);
+    check("idle samples hold the landing's GATE and never strike", gateHolds);
+    checkEq("the generator advanced once per landed hit, never otherwise",
+            (long long)r.seq.rng.state, (long long)model.state);
+    check("(the run played, skipped and landed on rests)", played > 0 && skippedHits > 0 && rests > 0);
+
+    // A reset onto a hit rolls once too.
+    Rig s(16, 16, 0);
+    s.seq.rng.seed(5);
+    Rng m;
+    m.seed(5);
+    s.settle();
+    Out o = at(s, true, false, 50);
+    bool plays = m.percent() < 50;
+    check("a reset rolls for step 1", o.struck == plays && o.gate == plays);
+    checkEq("exactly once", (long long)s.seq.rng.state, (long long)m.state);
+
+    // A same-sample reset and clock: the window swallows the clock, so only
+    // the reset lands and rolls.
+    o = at(s, false, false, 50);
+    s.idleFor(W);
+    o = at(s, true, true, 50);
+    m.percent();
+    checkEq("a same-sample reset and clock rolls once (the clock is swallowed)", (long long)s.seq.rng.state, (long long)m.state);
+    // Even with a zero window, where both land: only the final step rolls.
+    Rig z(16, 16, 0, 0);
+    z.seq.rng.seed(5);
+    o = at(z, true, true, 50);
+    Rng mz;
+    mz.seed(5);
+    plays = mz.percent() < 50;
+    check("with a zero window the clock's step is the one rolled", o.position == 1 && o.struck == plays);
+    checkEq("and only once", (long long)z.seq.rng.state, (long long)mz.state);
+}
+
+static void lostRollTests()
+{
+    std::printf("a lost roll holds GATE low until the playhead moves\n");
+    // Find a seed whose first percent() is >= 50 and second is < 50.
+    uint32_t seed = 1;
+    for (;; seed++)
+    {
+        Rng t;
+        t.seed(seed);
+        if (t.percent() >= 50 && t.percent() < 50) break;
+    }
+    Rig r(16, 16, 0);
+    r.seq.rng.seed(seed);
+    r.settle();
+    Out o = at(r, false, true, 50);
+    check("the clock lands on step 2", o.position == 1);
+    check("the lost roll strikes nothing", !o.struck);
+    check("and GATE is low on the landing sample", !o.gate);
+    uint32_t after = r.seq.rng.state;
+    bool low = true, quiet = true;
+    for (int i = 0; i < 3000; i++)
+    {
+        // Chance changes while idle are not rolled; 100 included.
+        Out q = at(r, false, false, (i < 1000) ? 50 : (i < 2000) ? 100 : 0);
+        if (q.gate) low = false;
+        if (q.struck) quiet = false;
+    }
+    check("GATE stays low on 3000 idle samples", low);
+    check("nothing strikes while idle", quiet);
+    checkEq("idle samples never roll", (long long)r.seq.rng.state, (long long)after);
+
+    o = at(r, false, true, 50);
+    check("the next clock rolls again and wins", o.position == 2 && o.struck && o.gate);
+    o = at(r, false, false, 50);
+    check("and GATE holds high on the next idle sample", o.gate && !o.struck);
+
+    // A ROT change that rewrites the table but leaves the playhead on a hit
+    // does not revive a lost roll. E(5,8) = x.x.xx.x: step 3 is a hit at
+    // ROT 0 and at ROT 2 (x.xx.xx.), a different table.
+    Rig p(5, 8, 0);
+    p.seq.rng.seed(seed);
+    p.settle();
+    o = at(p, false, true, 50);
+    check("(step 2 of E(5,8) is a rest: no roll)", o.position == 1 && !o.gate);
+    o = at(p, false, true, 50);
+    check("(step 3 is a hit and loses its roll)", o.position == 2 && !o.gate && !o.struck);
+    p.rot = 2;
+    o = at(p, false, false, 50);
+    check("(ROT 2 rewrote the table and step 3 is still a hit)",
+          p.seq.pattern.hit[2] && !p.seq.pattern.hit[1]);
+    check("a pattern change under a lost roll keeps GATE low", !o.gate && !o.struck);
+
+    // gate_gap still means "GATE was high on the previous sample": a reset
+    // straight after a lost roll reports no gap.
+    Rig g(16, 16, 0);
+    g.seq.rng.seed(seed);
+    g.settle();
+    at(g, false, true, 50);                      // lost
+    at(g, false, false, 50);
+    o = at(g, true, false, 50);                  // reset: wins (second roll < 50)
+    check("a reset after a lost roll reports no gap", !o.gate_gap);
+    check("and plays step 1", o.struck && o.gate && o.position == 0);
+    o = at(g, false, false, 50);
+    g.idleFor(W);
+    o = at(g, true, false, 100);
+    check("a reset while GATE is high still reports the gap", o.gate_gap);
+}
