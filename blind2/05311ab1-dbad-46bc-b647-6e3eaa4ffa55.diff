+    // zeroing, so this pins zero-then-count from the other side.
+    Rig r3(16, 16, 0);
+    r3.seq.accent_every = 3;
+    r3.settle();
+    r3.clocks(2);
+    o = r3.reset();
+    check("every 3: the reset strike after two strikes is not accented", o.struck && !o.accent);
+    r3.settle();
+    r3.clock();
+    o = r3.clock();
+    check("every 3: the third strike counting the reset's is accented", o.struck && o.accent);
+
+    // A reset onto a rest zeroes the count and strikes nothing.
+    Rig q(4, 16, 1);                              // rot 1: step 1 is a rest
+    q.seq.accent_every = 2;
+    q.settle();
+    int strikes = 0;
+    while (strikes < 3) { if (q.clock().struck) strikes++; }
+    o = q.reset();
+    check("reset onto a rest: no strike, no accent", !o.struck && !o.accent);
+    q.settle();
+    bool accent_of[3] = { false, false, false };   // [n] = strike n was accented
+    strikes = 0;
+    while (strikes < 2)
+    {
+        Out c = q.clock();
+        if (c.struck) accent_of[++strikes] = c.accent;
+    }
+    check("after a reset onto a rest the count restarts at strike 1", !accent_of[1] && accent_of[2]);
+
+    // A same-sample reset and clock is one strike, strike 1.
