+// ── Rng ──────────────────────────────────────────────────────────────────────
+//
+// xorshift32 (Marsaglia's 13 / 17 / 5), the generator behind CHANCE. Zero is
+// xorshift's one fixed point, so seed(0) falls back to the default state
+// rather than locking the generator at 0 forever.
+//
+struct Rng
+{
+    static const uint32_t DEFAULT_STATE = 0x9E3779B9u;
+
+    uint32_t state;
+
+    Rng() : state(DEFAULT_STATE) {}
+
+    void seed(uint32_t s)
+    {
+        // An if, not ?:, which would bind DEFAULT_STATE as an lvalue (an
+        // odr-use needing an out-of-class definition in C++11).
+        if (s == 0) s = DEFAULT_STATE;
+        state = s;
+    }
+
+    uint32_t next()
+    {
+        uint32_t x = state;
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        state = x;
+        return x;
+    }
+
+    // 0..99. The modulo bias (2^32 is not a multiple of 100) is under one
+    // part in forty million; irrelevant to a step probability.
+    int percent()
+    {
+        return (int)(next() % 100u);
+    }
+};
