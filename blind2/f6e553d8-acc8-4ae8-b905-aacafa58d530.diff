+// ── Chance ───────────────────────────────────────────────────────────────────
+//
+// The seven-argument process(). ChanceRig is Rig with a chance knob; the
+// tests above all go through Rig and so pin the six-argument form.
+
+struct ChanceRig
+{
+    Sequencer seq;
+    int hits, steps, rot, chance;
+
+    ChanceRig(int h, int s, int r, int c) : hits(h), steps(s), rot(r), chance(c)
+    {
+        seq.load(W);
+    }
+
+    Out idle()  { return seq.process(false, false, W, hits, steps, rot, chance); }
+    Out clock() { return seq.process(false, true,  W, hits, steps, rot, chance); }
+    Out reset() { return seq.process(true,  false, W, hits, steps, rot, chance); }
+
+    void settle() { for (int i = 0; i < W; i++) idle(); }
+};
+
+static bool sameOut(const Out &a, const Out &b)
+{
+    return a.gate == b.gate && a.struck == b.struck && a.gate_gap == b.gate_gap && a.position == b.position;
+}
+
+static void rngTests()
+{
+    std::printf("chance: the xorshift32 generator\n");
+    Rng rng;
+    checkEq("Rng starts at 0x9E3779B9", rng.state, 0x9E3779B9u);
+    checkEq("first next() from the default state", rng.next(), 1359758873u);
+    checkEq("and next() stores what it returns", rng.state, 1359758873u);
+    checkEq("second next()", rng.next(), 3761132862u);
+    checkEq("percent() is next() % 100", rng.percent(), 2075758394u % 100);
+
+    rng.seed(1);
+    checkEq("seed(1) stores 1", rng.state, 1);
+    checkEq("first next() after seed(1)", rng.next(), 270369u);
+    rng.seed(0);
+    checkEq("seed(0) falls back to 0x9E3779B9", rng.state, 0x9E3779B9u);
+
+    bool in_range = true;
+    for (int i = 0; i < 10000; i++)
+    {
+        int p = rng.percent();
+        if (p < 0 || p > 99) in_range = false;
+    }
+    check("percent() stays in 0..99", in_range);
+
+    Sequencer fresh;
+    checkEq("a fresh Sequencer's rng is at the default state", fresh.rng.state, 0x9E3779B9u);
+}
+
+static void chanceSixArgTests()
+{
+    std::printf("chance: the six-argument form is chance 100\n");
+
+    // Two sequencers in lockstep, one through each form, driven by the same
+    // pseudo-random resets, clocks and knob moves. Every Out field must agree
+    // on every sample and neither generator may move.
+    Rng drive;
+    drive.seed(0xC0FFEE42u);
+    Sequencer six, seven, over;
+    six.load(W);
+    seven.load(W);
+    over.load(W);
+
+    int h = 5, s = 8, r = 0;
+    bool agree = true, over_agrees = true;
+    int strikes = 0;
+    for (int i = 0; i < 100000; i++)
+    {
+        uint32_t x = drive.next();
+        bool reset = (x % 997) == 0;
+        bool clock = (x % 13) == 0;
+        if ((x % 5003) == 0) { h = (int)(x >> 8) % 33; s = 1 + (int)(x >> 16) % 32; r = (int)(x >> 4) % 40; }
+
+        Out a = six.process(reset, clock, W, h, s, r);
+        Out b = seven.process(reset, clock, W, h, s, r, 100);
+        Out c = over.process(reset, clock, W, h, s, r, 250);   // clamped to 100
+        if (!sameOut(a, b)) agree = false;
+        if (!sameOut(a, c)) over_agrees = false;
+        if (a.struck) strikes++;
+    }
+    check("six-argument and chance 100 agree on every sample", agree);
+    check("chance above 100 clamps to 100", over_agrees);
+    check("(the run struck something)", strikes > 100);
+    checkEq("the six-argument form never consumes the generator", six.rng.state, 0x9E3779B9u);
+    checkEq("chance 100 never consumes the generator", seven.rng.state, 0x9E3779B9u);
+    checkEq("chance 250 never consumes the generator", over.rng.state, 0x9E3779B9u);
+}
+
+static void chanceZeroTests()
+{
+    std::printf("chance: 0 silences every hit and rolls nothing\n");
+    ChanceRig r(16, 16, 0, 0);
+
+    // load is not a landing: step 1's gate follows the pattern.
+    Out o = r.idle();
+    check("after load step 1's gate follows the pattern, even at chance 0", o.gate);
+    check("(and nothing struck)", !o.struck);
+    r.settle();
+
+    bool silent = true;
+    for (int i = 0; i < 40; i++)
+    {
+        o = r.clock();
+        if (o.struck || o.gate) silent = false;
+        for (int j = 0; j < 20; j++)
+        {
+            o = r.idle();
+            if (o.struck || o.gate) silent = false;
+        }
+    }
+    check("40 clocks onto hits: no strike, GATE low throughout", silent);
+    checkEq("the playhead still advanced", r.seq.position, 40 % 16);
+
+    o = r.reset();
+    check("a reset onto a hit at chance 0 strikes nothing", !o.struck);
+    check("and GATE is low", !o.gate);
+    check("and GATE was low, so no gap", !o.gate_gap);
+    check("the pattern table is untouched", r.seq.pattern.count() == 16);
+    checkEq("chance 0 never consumes the generator", r.seq.rng.state, 0x9E3779B9u);
+
+    // A negative chance clamps to 0.
+    ChanceRig n(16, 16, 0, -20);
+    n.settle();
+    o = n.clock();
+    check("chance -20 behaves as 0", !o.struck && !o.gate);
+    checkEq("and rolls nothing", n.seq.rng.state, 0x9E3779B9u);
+}
+
+static void chanceDeterminismTests()
+{
+    std::printf("chance: a seeded generator replays the same verdicts\n");
+
+    // E(5,8) is x.x.xx.x: rests in between, so the test also shows that rests
+    // roll nothing. A reference Rng with the same seed predicts every verdict:
+    // one percent() per landing on a hit, none for rests or idle samples.
+    const uint32_t seed = 0x1234ABCDu;
+    ChanceRig a(5, 8, 0, 37), b(5, 8, 0, 37);
+    a.seq.rng.seed(seed);
+    b.seq.rng.seed(seed);
+    Rng ref;
+    ref.seed(seed);
+
+    a.settle();
+    b.settle();
+
+    bool replays = true, predicted = true;
+    int rolls = 0, wins = 0, landings = 0;
+    for (int i = 0; i < 400; i++)
+    {
+        bool reset = (i % 29) == 28;
+        Out oa = reset ? a.reset() : a.clock();
+        Out ob = reset ? b.reset() : b.clock();
+        landings++;
+        if (!sameOut(oa, ob)) replays = false;
+
+        if (a.seq.pattern.hit[oa.position])
+        {
+            bool plays = ref.percent() < 37;
+            rolls++;
+            if (plays) wins++;
+            if (oa.struck != plays || oa.gate != plays) predicted = false;
+        }
+        else if (oa.struck || oa.gate) predicted = false;
+
+        // A full window of idle samples after every landing (so the next
+        // reset's clock is never swallowed): the verdict holds, no re-roll.
+        for (int j = 0; j < W; j++)
+        {
+            Out ia = a.idle();
+            Out ib = b.idle();
+            if (!sameOut(ia, ib)) replays = false;
+            if (ia.struck || ia.gate != oa.gate) predicted = false;
+        }
+    }
+    check("two sequencers with the same seed agree on every sample", replays);
+    check("every verdict matches a reference generator: one roll per hit landing", predicted);
+    checkEq("the generator advanced exactly once per hit landing", a.seq.rng.state, ref.state);
+    check("(some rolls won and some lost)", wins > 0 && wins < rolls);
+    check("(rests were landed on too)", rolls < landings);
+
+    // A different seed gives a different run.
+    ChanceRig c(5, 8, 0, 37);
+    c.seq.rng.seed(seed + 1);
+    c.settle();
+    ChanceRig d(5, 8, 0, 37);
+    d.seq.rng.seed(seed);
+    d.settle();
+    bool differs = false;
+    for (int i = 0; i < 200; i++) if (!sameOut(c.clock(), d.clock())) differs = true;
+    check("a different seed gives a different run", differs);
+}
+
+// A seed whose first roll is >= 50 (loses at chance 50) and second < 50 (wins).
+static uint32_t loseThenWinSeed()
+{
+    for (uint32_t s = 1; s < 100000; s++)
+    {
+        Rng probe;
+        probe.seed(s);
+        int first = probe.percent();
+        int second = probe.percent();
+        if (first >= 50 && second < 50) return s;
+    }
+    return 0;
+}
+
+static void chanceLostRollTests()
+{
+    std::printf("chance: a lost roll holds GATE low until the playhead moves\n");
+    const uint32_t seed = loseThenWinSeed();
+    check("(found a lose-then-win seed)", seed != 0);
+
+    // All hits, so both landings below are rolled.
+    ChanceRig r(16, 16, 0, 50);
+    r.seq.rng.seed(seed);
+
+    // load did not roll, and step 1's gate follows the pattern.
+    Out o = r.idle();
+    check("after load step 1's gate is high", o.gate);
+    checkEq("and load rolled nothing", r.seq.rng.state, seed);
+    r.settle();
+
+    o = r.clock();
+    checkEq("(landed on step 2)", o.position, 1);
+    check("the lost roll strikes nothing", !o.struck);
+    check("and GATE is low on the landing sample", !o.gate);
+    const uint32_t after_roll = r.seq.rng.state;
+    check("(one roll was made)", after_roll != seed);
+
+    bool held_low = true;
+    for (int i = 0; i < 500; i++)
+    {
+        o = r.idle();
+        if (o.gate || o.struck || o.position != 1) held_low = false;
+    }
+    check("GATE stays low on every idle sample of the stay", held_low);
+    checkEq("idle samples never re-roll", r.seq.rng.state, after_roll);
+
+    // Moving ROT mid-stay keeps the current step a hit: still silent, no roll.
+    r.rot = 3;
+    o = r.idle();
+    check("a pattern change mid-stay does not revive the lost step", !o.gate && !o.struck);
+    checkEq("nor roll", r.seq.rng.state, after_roll);
+    check("the pattern table is not changed by a lost roll", r.seq.pattern.count() == 16);
+
+    o = r.clock();
+    checkEq("the next clock moves to step 3", o.position, 2);
+    check("its roll wins: it strikes", o.struck);
+    check("and GATE is high", o.gate);
+    check("no gap: a gap is a reset's", !o.gate_gap);
+
+    // A reset from a lost step: GATE was low, so no gap.
+    ChanceRig g(16, 16, 0, 50);
+    g.seq.rng.seed(seed);
+    g.settle();
+    g.clock();                                 // loses
+    g.idle();
+    o = g.reset();                             // wins
+    check("a reset from a lost step reports no gate gap", !o.gate_gap);
+    check("and strikes step 1 when its own roll wins", o.struck && o.gate);
+
+    // The reset onto step 1 is itself a landing and can lose.
+    ChanceRig z(16, 16, 0, 50);
+    z.seq.rng.seed(seed);
+    o = z.idle();
+    check("(GATE high on step 1 after load)", o.gate);
+    o = z.reset();                             // loses
+    check("a reset whose roll loses strikes nothing", !o.struck);
+    check("and holds GATE low", !o.gate);
+    check("but the gap still reflects the previous sample's GATE", o.gate_gap);
+    o = z.idle();
+    check("and GATE stays low after it", !o.gate);
+}
