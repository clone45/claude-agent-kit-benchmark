+// ── ACCENT: every Nth struck sample ──────────────────────────────────────────
+
+// Clock a settled all-hits rig `strikes` times; each clock is one strike.
+// Returns accent per strike (1 / 0), checking accent is false off strikes.
+static std::vector<int> accentRun(int every, int strikes)
+{
+    Rig r(16, 16, 0);
+    r.seq.accent_every = every;
+    r.settle();
+    std::vector<int> got;
+    for (int i = 0; i < strikes; i++)
+    {
+        Out o = r.clock();
+        if (!o.struck) { check("accentRun: every clock strikes", false); break; }
+        got.push_back(o.accent ? 1 : 0);
+    }
+    return got;
+}
+
+static int expectedAccent(int n, int hit_number)
+{
+    return n >= 1 && hit_number % n == 0;
+}
+
+// Clock until a strike (at most 16 clocks); returns it.
+static Out clockToStrike(Rig& r)
+{
+    Out o = r.clock();
+    for (int i = 0; i < 16 && !o.struck; i++) o = r.clock();
+    return o;
+}
+
+static void accentTests()
+{
+    std::printf("accent\n");
+
+    // Off by default: never accents, on or off a strike.
+    {
+        Rig r(3, 8, 0);
+        checkEq("default accent_every is 0", r.seq.accent_every, 0);
+        r.settle();
+        bool any = false;
+        for (int i = 0; i < 200; i++)
+        {
+            Out o = (i % 2) ? r.clock() : r.idle();
+            if (o.accent) any = true;
+        }
+        check("accent_every 0 never accents over many hits", !any);
+    }
+
+    // Every 1 accents every strike; every 2 accents the 2nd, 4th, 6th...
+    {
+        std::vector<int> a = accentRun(1, 10);
+        bool all = a.size() == 10;
+        for (size_t i = 0; i < a.size(); i++) all = all && a[i] == 1;
+        check("every 1 accents every strike", all);
+
+        std::vector<int> b = accentRun(2, 6);
+        int want[6] = { 0, 1, 0, 1, 0, 1 };
+        for (int i = 0; i < 6; i++) checkEq("every 2: strike parity", b[i], want[i]);
+    }
+
+    // Counting is per hit, not per step: 3 hits in 8 steps, every 2.
+    {
+        Rig r(3, 8, 0);
+        r.seq.accent_every = 2;
+        r.settle();
+        int strikes = 0;
+        bool ok = true;
+        for (int i = 0; i < 8 * 4; i++)
+        {
+            Out o = r.clock();
+            if (o.struck) strikes++;
+            if (o.accent != (o.struck && strikes % 2 == 0)) ok = false;
+        }
+        checkEq("3 hits x 4 bars = 12 strikes (no strike on a rest)", strikes, 12);
+        check("every 2 on 3 hits in 8 steps accents hits 2, 4, 6... not steps", ok);
+        checkEq("hit_count counts strikes", r.seq.hit_count, 12);
+    }
+
+    // Reset: a reset that plays step 1 makes it hit 1.
+    {
+        Rig r(16, 16, 0);
+        r.seq.accent_every = 2;
+        r.settle();
+        r.clocks(3);                                  // hits 1, 2, 3
+        checkEq("three strikes counted", r.seq.hit_count, 3);
+        Out o = r.reset();
+        check("reset strikes step 1", o.struck);
+        check("reset's strike is hit 1: not accented at every 2", !o.accent);
+        checkEq("hit_count is 1 after the reset's strike", r.seq.hit_count, 1);
+        r.settle();
+        o = r.clock();
+        check("the next hit is hit 2: accented", o.struck && o.accent);
+    }
+
+    // Reset onto a rest leaves the counter at 0.
+    {
+        int rot = -1;
+        for (int k = 0; k < 8 && rot < 0; k++)
+        {
+            Pattern p;
+            p.compute(3, 8, k);
+            if (!p.hit[0]) rot = k;
+        }
+        check("found a rotation with step 1 a rest", rot >= 0);
+
+        Rig r(3, 8, rot);
+        r.seq.accent_every = 2;
+        r.settle();
+        Out o = clockToStrike(r);
+        check("first hit is not accented at every 2", o.struck && !o.accent);
+        checkEq("one strike counted", r.seq.hit_count, 1);
+        o = r.reset();
+        check("reset onto a rest does not strike", !o.struck && !o.accent);
+        checkEq("reset onto a rest zeroes the counter", r.seq.hit_count, 0);
+        r.settle();
+        o = clockToStrike(r);
+        check("next hit is hit 1: not accented", o.struck && !o.accent);
+        o = clockToStrike(r);
+        check("the one after is hit 2: accented", o.struck && o.accent);
+    }
+
+    // load() zeroes the counter.
+    {
+        Rig r(16, 16, 0);
+        r.seq.accent_every = 2;
+        r.settle();
+        r.clocks(3);
+        r.seq.load(W);
+        checkEq("load zeroes hit_count", r.seq.hit_count, 0);
+        r.settle();
+        Out o = r.clock();
+        check("first strike after load is hit 1: not accented", o.struck && !o.accent);
+    }
+
+    // Clamp: 9 and 100 behave as 8, -1 as off.
+    {
+        const int values[4] = { 9, 100, 8, -1 };
+        const int effective[4] = { 8, 8, 8, 0 };
+        for (int v = 0; v < 4; v++)
+        {
+            std::vector<int> a = accentRun(values[v], 24);
+            bool ok = a.size() == 24;
+            for (size_t i = 0; ok && i < a.size(); i++) ok = a[i] == expectedAccent(effective[v], (int)i + 1);
+            check("accent_every clamps to 0..8", ok);
+        }
+    }
+
+    // Changing accent_every mid-run never touches the counter.
+    {
+        Rig r(16, 16, 0);
+        r.settle();
+        r.clocks(3);                                  // hits 1..3 with accent off
+        r.seq.accent_every = 2;
+        checkEq("changing accent_every leaves hit_count", r.seq.hit_count, 3);
+        Out o = r.clock();
+        check("the 4th hit accents at every 2", o.struck && o.accent);
+    }
+
+    // A lost chance roll is not struck and not counted.
+    {
+        ChanceRig r(8, 8, 0, 50);
+        r.seq.rng.seed(7);
+        r.seq.accent_every = 2;
+        r.settle();
+        Rng replica;
+        replica.seed(7);
+        int wins = 0, lost = 0;
+        bool ok = true;
+        for (int i = 0; i < 200; i++)
+        {
+            const bool wins_roll = replica.percent() < 50;
+            Out o = r.clock();
+            if (wins_roll) wins++; else lost++;
+            if (o.struck != wins_roll) ok = false;
+            if (o.accent != (wins_roll && wins % 2 == 0)) ok = false;
+        }
+        check("accent follows the winning rolls only", ok);
+        check("the run had lost rolls and wins", wins > 0 && lost > 0);
+        checkEq("hit_count counts only won rolls", r.seq.hit_count, wins % 840 == 0 ? 840 : wins % 840);
+    }
+
+    // The 840 wrap is invisible: every n in 1..8 matches an unbounded count.
+    {
+        for (int n = 1; n <= 8; n++)
+        {
+            Rig r(16, 16, 0);
+            r.seq.accent_every = n;
+            r.settle();
+            bool ok = true;
+            for (int i = 1; i <= 2000; i++)
+            {
+                Out o = r.clock();
+                if (!o.struck || (o.accent ? 1 : 0) != expectedAccent(n, i)) ok = false;
+                if (r.seq.hit_count < 1 || r.seq.hit_count > 840) ok = false;
+            }
+            check("accent matches an unbounded count over 2000 strikes", ok);
+        }
+    }
+}
+
 int main()
 {
     loadTests();
