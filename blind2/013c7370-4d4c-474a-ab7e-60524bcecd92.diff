diff --git a/tests/vx_drum_sequencer/direction_test.cpp b/tests/vx_drum_sequencer/direction_test.cpp
new file mode 100644
index 0000000..a5710b6
--- /dev/null
+++ b/tests/vx_drum_sequencer/direction_test.cpp
@@ -0,0 +1,243 @@
+// VX Drum Sequencer engine: playback direction. Playhead::advance in FORWARD,
+// BACKWARD and PENDULUM, the hand-off (-1) landing on step 1 in each, a length
+// that shrank below the playhead, the reset rule (step 1 current, PENDULUM
+// heading forward), and Sequencer::setDirection / direction() end to end.
+//
+//   g++ -std=c++11 -O2 -I ../../src/modules/VXDrumSequencer -o direction_test direction_test.cpp && ./direction_test
+
+#include "VXDrumSequencerEngine.hpp"
+#include "check.hpp"
+
+using namespace vx_drum_sequencer;
+
+static const float SR = 48000.f;
+static const int WINDOW = 48;    // vgLib_v2::ResetClockWindow::samplesFor(48000)
+
+static float OUT[LANES];
+
+// `n` successive advances at `length` match `want`.
+static bool advances(Playhead& p, int length, const int* want, int n)
+{
+    for (int i = 0; i < n; i++)
+    {
+        if (p.advance(length) != want[i]) return false;
+    }
+    return true;
+}
+
+static Playhead headAt(int direction, int position)
+{
+    Playhead p;
+    p.direction = direction;
+    p.position = position;
+    return p;
+}
+
+static void forwardTests()
+{
+    std::printf("FORWARD\n");
+
+    Playhead p;
+    checkEq("a fresh Playhead is FORWARD", p.direction, FORWARD);
+
+    const int want[] = {1, 2, 3, 0, 1, 2, 3, 0};
+    check("length 4 from step 1: 2 3 4 1 2 3 4 1", advances(p, 4, want, 8));
+
+    Playhead one = headAt(FORWARD, 0);
+    const int ones[] = {0, 0, 0};
+    check("length 1 stays on step 1", advances(one, 1, ones, 3));
+
+    Playhead shrunk = headAt(FORWARD, 9);
+    checkEq("a position past a shrunken length wraps to step 1", shrunk.advance(4), 0);
+
+    Playhead clamped = headAt(FORWARD, STEPS - 1);
+    checkEq("a length above STEPS is clamped (wraps at STEPS)", clamped.advance(STEPS + 10), 0);
+}
+
+static void backwardTests()
+{
+    std::printf("BACKWARD\n");
+
+    Playhead p = headAt(BACKWARD, 0);
+    const int want[] = {3, 2, 1, 0, 3, 2, 1, 0};
+    check("length 4 from step 1: 4 3 2 1 4 3 2 1", advances(p, 4, want, 8));
+
+    Playhead one = headAt(BACKWARD, 0);
+    const int ones[] = {0, 0, 0};
+    check("length 1 stays on step 1", advances(one, 1, ones, 3));
+
+    Playhead shrunk = headAt(BACKWARD, 9);
+    checkEq("a position past a shrunken length goes to the last step", shrunk.advance(4), 3);
+    checkEq("and carries on backward", shrunk.advance(4), 2);
+
+    Playhead at_len = headAt(BACKWARD, 4);
+    checkEq("a position exactly at the length goes to the last step", at_len.advance(4), 3);
+
+    Playhead zero_len = headAt(BACKWARD, 0);
+    checkEq("a length below 1 is clamped to 1", zero_len.advance(0), 0);
+}
+
+static void pendulumTests()
+{
+    std::printf("PENDULUM\n");
+
+    Playhead p = headAt(PENDULUM, 0);
+    const int want[] = {1, 2, 3, 2, 1, 0, 1, 2, 3, 2, 1, 0};
+    check("length 4 from step 1: 2 3 4 3 2 1 2 3 4 3 2 1 (ends not repeated)", advances(p, 4, want, 12));
+
+    Playhead two = headAt(PENDULUM, 0);
+    const int twos[] = {1, 0, 1, 0, 1};
+    check("length 2 alternates", advances(two, 2, twos, 5));
+
+    Playhead one = headAt(PENDULUM, 0);
+    const int ones[] = {0, 0, 0, 0};
+    check("length 1: every call returns step 1", advances(one, 1, ones, 4));
+
+    Playhead shrunk = headAt(PENDULUM, 9);
+    checkEq("a position past a shrunken length goes to the last step", shrunk.advance(4), 3);
+    const int back[] = {2, 1, 0, 1};
+    check("and the next move is backward, then it bounces", advances(shrunk, 4, back, 4));
+
+    Playhead at_len = headAt(PENDULUM, 4);
+    checkEq("a position exactly at the length goes to the last step", at_len.advance(4), 3);
+    checkEq("and heads back", at_len.advance(4), 2);
+
+    // Shrinking mid-descent: the heading survives, the position is pulled in.
+    Playhead mid = headAt(PENDULUM, 0);
+    const int up[] = {1, 2, 3, 4, 5, 6, 7, 6, 5};
+    check("(length 8 up to 8 and back to 6)", advances(mid, 8, up, 9));
+    checkEq("shrinking to 4 under the playhead lands on the last step", mid.advance(4), 3);
+    checkEq("and keeps descending", mid.advance(4), 2);
+
+    Playhead one_shrunk = headAt(PENDULUM, 5);
+    checkEq("a shrink to length 1 lands on step 1", one_shrunk.advance(1), 0);
+    checkEq("and stays there", one_shrunk.advance(1), 0);
+    checkEq("growing again from step 1 moves forward", one_shrunk.advance(4), 1);
+}
+
+static void handOffTests()
+{
+    std::printf("hand-off (position -1)\n");
+
+    const int dirs[] = {FORWARD, BACKWARD, PENDULUM};
+    const char* lands[] = {"FORWARD: a hand-off lands on step 1",
+                           "BACKWARD: a hand-off lands on step 1",
+                           "PENDULUM: a hand-off lands on step 1"};
+    for (int i = 0; i < 3; i++)
+    {
+        Playhead p = headAt(dirs[i], 2);
+        p.rewind();
+        checkEq("rewind() still parks the playhead on -1", p.position, -1);
+        checkEq(lands[i], p.advance(4), 0);
+    }
+
+    // PENDULUM mid-descent, then a hand-off: the next move is forward.
+    Playhead p = headAt(PENDULUM, 0);
+    const int down[] = {1, 2, 3, 2};
+    check("(PENDULUM descending at step 3)", advances(p, 4, down, 4));
+    p.rewind();
+    checkEq("PENDULUM: the hand-off lands on step 1", p.advance(4), 0);
+    checkEq("PENDULUM: the move after a hand-off is forward", p.advance(4), 1);
+
+    Playhead b = headAt(BACKWARD, 3);
+    b.rewind();
+    b.advance(4);
+    checkEq("BACKWARD: after a hand-off onto step 1 the next is the last step", b.advance(4), 3);
+}
+
+static void resetTests()
+{
+    std::printf("reset\n");
+
+    Playhead p = headAt(PENDULUM, 0);
+    const int down[] = {1, 2, 3, 2};
+    check("(PENDULUM descending at step 3)", advances(p, 4, down, 4));
+    p.reset();
+    checkEq("reset() puts step 1 current", p.position, 0);
+    checkEq("PENDULUM: the move after a reset is forward", p.advance(4), 1);
+
+    Playhead b = headAt(BACKWARD, 2);
+    b.reset();
+    checkEq("BACKWARD: reset() puts step 1 current", b.position, 0);
+    checkEq("BACKWARD: the clock after a reset plays the last step", b.advance(4), 3);
+
+    Playhead f = headAt(FORWARD, 2);
+    f.reset();
+    checkEq("FORWARD: the clock after a reset plays step 2", f.advance(4), 1);
+
+    Playhead d = headAt(BACKWARD, 2);
+    d.reset();
+    checkEq("reset() leaves the direction alone", d.direction, BACKWARD);
+}
+
+static void sequencerTests()
+{
+    std::printf("Sequencer::setDirection\n");
+
+    Sequencer s;
+    checkEq("a fresh Sequencer is FORWARD", s.direction(), FORWARD);
+
+    s.setDirection(BACKWARD);
+    checkEq("setDirection(BACKWARD)", s.direction(), BACKWARD);
+    checkEq("is stored on the playhead", s.head.direction, BACKWARD);
+    s.setDirection(PENDULUM);
+    checkEq("setDirection(PENDULUM)", s.direction(), PENDULUM);
+    s.setDirection(3);
+    checkEq("3 is FORWARD", s.direction(), FORWARD);
+    s.setDirection(BACKWARD);
+    s.setDirection(-1);
+    checkEq("-1 is FORWARD", s.direction(), FORWARD);
+
+    // End to end: a reset plays step 1, the window swallows its clock, the
+    // clocks after it follow the pendulum.
+    Memory m;
+    m.length = 4;
+    PlaySource src;
+    src.memory = &m;
+
+    Sequencer q;
+    q.setDirection(PENDULUM);
+    q.rewind(WINDOW);
+    for (int i = 0; i < WINDOW; i++) q.process(false, src, SR, 48, OUT);
+    q.reset(src, WINDOW);
+    q.process(true, src, SR, 48, OUT);
+    checkEq("a same-sample reset + clock stays on step 1", q.head.position, 0);
+    for (int i = 0; i < WINDOW; i++) q.process(false, src, SR, 48, OUT);
+
+    const int want[] = {1, 2, 3, 2, 1, 0, 1};
+    bool ok = true;
+    for (int i = 0; i < 7; i++)
+    {
+        q.process(true, src, SR, 48, OUT);
+        if (q.head.position != want[i] || q.report.position != want[i]) ok = false;
+    }
+    check("clocks after the window follow the pendulum, report included", ok);
+
+    // Backward end to end from a reset.
+    Sequencer r;
+    r.setDirection(BACKWARD);
+    r.rewind(WINDOW);
+    for (int i = 0; i < WINDOW; i++) r.process(false, src, SR, 48, OUT);
+    r.reset(src, WINDOW);
+    for (int i = 0; i < WINDOW; i++) r.process(false, src, SR, 48, OUT);
+    r.process(true, src, SR, 48, OUT);
+    checkEq("BACKWARD: the first clock after a reset's window plays the last step", r.head.position, 3);
+    r.process(true, src, SR, 48, OUT);
+    checkEq("BACKWARD: then the one before it", r.head.position, 2);
+
+    // A hand-off through the Sequencer in BACKWARD still lands on step 1.
+    r.handOff();
+    r.process(true, src, SR, 48, OUT);
+    checkEq("BACKWARD: a Sequencer hand-off lands on step 1", r.head.position, 0);
+}
+
+int main()
+{
+    forwardTests();
+    backwardTests();
+    pendulumTests();
+    handOffTests();
+    resetTests();
+    sequencerTests();
+    return finish("direction_test");
+}
