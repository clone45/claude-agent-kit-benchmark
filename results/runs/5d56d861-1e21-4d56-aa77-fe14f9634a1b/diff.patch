diff --git a/tests/typing/typing_path.py b/tests/typing/typing_path.py
new file mode 100644
index 0000000..7592f28
--- /dev/null
+++ b/tests/typing/typing_path.py
@@ -0,0 +1,63 @@
+import os
+import pathlib
+
+from typing_extensions import assert_type
+
+import click
+
+# ``path_type`` narrows the converted value type.
+assert_type(
+    click.Path(path_type=pathlib.Path).convert("a/b.txt", None, None), pathlib.Path
+)
+assert_type(click.Path(path_type=str).convert("a/b.txt", None, None), str)
+assert_type(click.Path(path_type=bytes).convert("a/b.txt", None, None), bytes)
+assert_type(
+    click.Path(exists=True, path_type=pathlib.Path).convert("a/b.txt", None, None),
+    pathlib.Path,
+)
+assert_type(
+    click.Path(False, True, True, False, True, False, False, pathlib.Path).convert(
+        "a/b.txt", None, None
+    ),
+    pathlib.Path,
+)
+
+# Without ``path_type``, the value type is unchanged.
+assert_type(click.Path().convert("a/b.txt", None, None), str | bytes | os.PathLike[str])
+assert_type(
+    click.Path(path_type=None).convert("a/b.txt", None, None),
+    str | bytes | os.PathLike[str],
+)
+assert_type(click.Path(), click.Path[str | bytes | os.PathLike[str]])
+
+# A dynamic ``path_type`` falls back to the default value type.
+maybe_type: type | None = None
+assert_type(
+    click.Path(path_type=maybe_type).convert("a/b.txt", None, None),
+    str | bytes | os.PathLike[str],
+)
+
+# ``coerce_path_result`` is narrowed as well.
+assert_type(
+    click.Path(path_type=pathlib.Path).coerce_path_result("a/b.txt"), pathlib.Path
+)
+assert_type(click.Path().coerce_path_result("a/b.txt"), str | bytes | os.PathLike[str])
+
+# Explicit annotations.
+explicit: click.Path[pathlib.Path] = click.Path(path_type=pathlib.Path)
+assert_type(explicit.convert("a/b.txt", None, None), pathlib.Path)
+param_type: click.ParamType[pathlib.Path] = click.Path(path_type=pathlib.Path)
+default_param_type: click.ParamType[str | bytes | os.PathLike[str]] = click.Path()
+
+# Calling the instance directly.
+assert_type(
+    click.Path(path_type=pathlib.Path)(pathlib.PurePosixPath("a/b.txt")),
+    pathlib.Path,
+)
+assert_type(click.Path(path_type=str)("a/b.txt"), str)
+assert_type(click.Path(path_type=pathlib.Path)(None), None)
+assert_type(click.Path()("a/b.txt"), str | bytes | os.PathLike[str])
+
+# The narrowed type flows through ``click.prompt``.
+assert_type(click.prompt("File", type=click.Path(path_type=pathlib.Path)), pathlib.Path)
+assert_type(click.prompt("File", type=click.Path()), str | bytes | os.PathLike[str])
