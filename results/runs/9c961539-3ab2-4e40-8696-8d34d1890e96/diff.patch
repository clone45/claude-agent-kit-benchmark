+def _make_input_funcs(
+    text_input: t.Iterator[str], echo_input: t.BinaryIO | None
+) -> tuple[t.Callable[..., str], t.Callable[..., str], t.Callable[[bool], str]]:
+    """Build the ``visible_prompt_func``, ``hidden_prompt_func`` and
+    ``_getchar`` replacements used by :meth:`CliRunner.isolation`. They
+    read from ``text_input`` and pause echoing of ``echo_input`` while
+    they write the prompt and answer themselves.
+    """
+
+    @_pause_echo(echo_input)  # type: ignore
+    def visible_input(prompt: str | None = None) -> str:
+        sys.stdout.write(prompt or "")
+        try:
+            val = next(text_input).rstrip("\r\n")
+        except StopIteration as e:
+            raise EOFError() from e
+        sys.stdout.write(f"{val}\n")
+        sys.stdout.flush()
+        return val
+
+    @_pause_echo(echo_input)  # type: ignore
+    def hidden_input(prompt: str | None = None) -> str:
+        sys.stdout.write(f"{prompt or ''}\n")
+        sys.stdout.flush()
+        try:
+            return next(text_input).rstrip("\r\n")
+        except StopIteration as e:
+            raise EOFError() from e
+
+    @_pause_echo(echo_input)  # type: ignore
+    def _getchar(echo: bool) -> str:
+        char = sys.stdin.read(1)
+
+        if echo:
+            sys.stdout.write(char)
+
+        sys.stdout.flush()
+        return char
+
+    return visible_input, hidden_input, _getchar
+
+
+def _make_should_strip_ansi(
+    default_color: bool,
+) -> t.Callable[..., bool]:
+    """Build the ``should_strip_ansi`` replacement used by
+    :meth:`CliRunner.isolation`, which strips ANSI codes unless color is
+    enabled by the call or by ``default_color``.
+    """
+
+    def should_strip_ansi(
+        stream: t.IO[t.Any] | None = None, color: bool | None = None
+    ) -> bool:
+        if color is None:
+            return not default_color
+        return not color
+
+    return should_strip_ansi
+
+
+def _make_pdb_init(
+    old_pdb_init: t.Callable[..., None],
+) -> t.Callable[..., None]:
+    """Build the ``pdb.Pdb.__init__`` replacement used by
+    :meth:`CliRunner.isolation`, wrapping ``old_pdb_init``.
+    """
+
+    def _patched_pdb_init(
+        self: pdb.Pdb,
+        completekey: str = "tab",
+        stdin: t.IO[str] | None = None,
+        stdout: t.IO[str] | None = None,
+        **kwargs: t.Any,
+    ) -> None:
+        """Default ``pdb.Pdb`` to real terminal streams during
+        ``CliRunner`` isolation.
+
+        Without this patch, ``pdb.Pdb.__init__`` inherits from
+        ``cmd.Cmd`` which falls back to ``sys.stdin``/``sys.stdout``
+        when no explicit streams are provided. During isolation
+        those are ``BytesIO``-backed wrappers, so the debugger
+        reads from an empty buffer and writes to captured output,
+        making interactive debugging impossible.
+
+        By defaulting to ``sys.__stdin__``/``sys.__stdout__`` (the
+        original terminal streams Python preserves regardless of
+        redirection), debuggers can interact with the user while
+        ``click.echo`` output is still captured normally.
+
+        This covers ``pdb.set_trace()``, ``breakpoint()``,
+        ``pdb.post_mortem()``, and debuggers that subclass
+        ``pdb.Pdb`` (ipdb, pdbpp). Explicit ``stdin``/``stdout``
+        arguments are honored and not overridden. Debuggers that
+        do not subclass ``pdb.Pdb`` (pudb, debugpy) are not
+        covered.
+        """
+        if stdin is None:
+            stdin = sys.__stdin__
+        if stdout is None:
+            stdout = sys.__stdout__
+        old_pdb_init(
+            self, completekey=completekey, stdin=stdin, stdout=stdout, **kwargs
+        )
+
+    return _patched_pdb_init
+
+
+class _IsolatedStreams:
+    """The replacement standard streams and terminal functions that
+    :meth:`CliRunner.isolation` installs while a command runs.
+
+    ``mixer`` holds the captured ``stdout``, ``stderr`` and interleaved
+    ``output`` bytes. If ``echo_stdin`` is set, everything read from
+    ``stdin`` is echoed to ``stdout``.
+    """
+
+    def __init__(
+        self,
+        bytes_input: t.BinaryIO,
+        charset: str,
+        echo_stdin: bool,
+        color: bool,
+    ) -> None:
+        self.mixer = StreamMixer()
+        echo_input = None
+
+        if echo_stdin:
+            bytes_input = echo_input = t.cast(
+                t.BinaryIO, EchoingStdin(bytes_input, self.mixer.stdout)
+            )
+
+        self.stdin = _NamedTextIOWrapper(
+            bytes_input, encoding=charset, name="<stdin>", mode="r"
+        )
+
+        if echo_stdin:
+            # Force unbuffered reads, otherwise TextIOWrapper reads a
+            # large chunk which is echoed early.
+            self.stdin._CHUNK_SIZE = 1  # type: ignore
+
+        self.stdout = _NamedTextIOWrapper(
+            self.mixer.stdout,
+            encoding=charset,
+            name="<stdout>",
+            mode="w",
+        )
+        self.stderr = _NamedTextIOWrapper(
+            self.mixer.stderr,
+            encoding=charset,
+            name="<stderr>",
+            mode="w",
+            errors="backslashreplace",
+        )
+        self.visible_input, self.hidden_input, self.getchar = _make_input_funcs(
+            self.stdin, echo_input
+        )
+        self.should_strip_ansi = _make_should_strip_ansi(color)
+
+
+class _SavedGlobals:
+    """Snapshot of the global state that :meth:`CliRunner.isolation`
+    replaces, so :meth:`restore` can put it back afterwards.
+    """
+
+    def __init__(self) -> None:
+        self.stdin = sys.stdin
+        self.stdout = sys.stdout
+        self.stderr = sys.stderr
+        self.forced_width = formatting.FORCED_WIDTH
+        self.visible_prompt_func = termui.visible_prompt_func
+        self.hidden_prompt_func = termui.hidden_prompt_func
+        self.getchar = termui._getchar
+        self.utils_should_strip_ansi = utils.should_strip_ansi  # type: ignore
+        self.compat_should_strip_ansi = _compat.should_strip_ansi
+        self.pdb_init = pdb.Pdb.__init__
+        self.env: dict[str, str | None] = {}
+
+    def apply_env(self, env: cabc.Mapping[str, str | None]) -> None:
+        """Apply ``env`` to ``os.environ``, saving each previous value.
+        A value of ``None`` removes the variable.
+        """
+        for key, value in env.items():
+            self.env[key] = os.environ.get(key)
+            _set_environ(key, value)
+
+    def restore(self) -> None:
+        """Restore the environment and every saved global."""
+        for key, value in self.env.items():
+            _set_environ(key, value)
+        sys.stdout = self.stdout
+        sys.stderr = self.stderr
+        sys.stdin = self.stdin
+        termui.visible_prompt_func = self.visible_prompt_func
+        termui.hidden_prompt_func = self.hidden_prompt_func
+        termui._getchar = self.getchar
+        utils.should_strip_ansi = self.utils_should_strip_ansi  # type: ignore
+        _compat.should_strip_ansi = self.compat_should_strip_ansi
+        formatting.FORCED_WIDTH = self.forced_width
+        pdb.Pdb.__init__ = self.pdb_init  # type: ignore[method-assign]
+
+
+def _set_environ(key: str, value: str | None) -> None:
+    """Set ``os.environ[key]``, or remove it if ``value`` is ``None``."""
+    if value is None:
+        try:
+            del os.environ[key]
+        except Exception:
+            pass
+    else:
+        os.environ[key] = value
+
