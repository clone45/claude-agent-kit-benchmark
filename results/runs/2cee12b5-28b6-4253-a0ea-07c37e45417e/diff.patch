diff --git a/src/click/_utils.py b/src/click/_utils.py
index 05ee2e9..7900b40 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,21 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    # Sentinels are singletons, so duplicating one must return the same member.
+    # The default ``Enum`` reduction rebuilds the member from its value, which
+    # is a bare ``object()`` that does not survive copying or pickling.
+
+    def __copy__(self) -> Sentinel:
+        return self
+
+    def __deepcopy__(self, memo: dict[int, t.Any]) -> Sentinel:
+        return self
+
+    def __reduce_ex__(self, protocol: object) -> tuple[t.Any, ...]:
+        # Look the member up on its class when unpickling, like
+        # ``enum.pickle_by_enum_name`` (Python 3.12+).
+        return getattr, (self.__class__, self.name)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
