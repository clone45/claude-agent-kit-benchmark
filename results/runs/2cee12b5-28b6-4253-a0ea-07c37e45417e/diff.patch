@@ -1,6 +1,12 @@
+import copy
+import pickle
 from decimal import Decimal
 from fractions import Fraction
 
+import pytest
+
+import click
+from click._utils import Sentinel
 from click._utils import UNSET
 
 
@@ -50,3 +56,47 @@ def test_unset_sentinel():
         assert value is not real_value
 
     assert value not in real_values
+
+
+def _pickle_round_trip(value):
+    return pickle.loads(pickle.dumps(value))
+
+
+DUPLICATORS = pytest.mark.parametrize(
+    "duplicate",
+    (copy.copy, copy.deepcopy, _pickle_round_trip),
+    ids=("copy", "deepcopy", "pickle"),
+)
+
+
+@pytest.mark.parametrize("sentinel", tuple(Sentinel))
+@DUPLICATORS
+def test_sentinel_duplication_preserves_identity(sentinel, duplicate):
+    """Sentinels are singletons: copying or pickling one returns the member."""
+    assert duplicate(sentinel) is sentinel
+
+
+@pytest.mark.parametrize("sentinel", tuple(Sentinel))
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+def test_sentinel_pickle_all_protocols(sentinel, protocol):
+    assert pickle.loads(pickle.dumps(sentinel, protocol=protocol)) is sentinel
+
+
+@DUPLICATORS
+def test_sentinel_duplication_in_container(duplicate):
+    """Identity is preserved when sentinels are nested in other objects."""
+    value = {"members": list(Sentinel), "unset": UNSET}
+    duplicated = duplicate(value)
+    assert duplicated["unset"] is UNSET
+    assert all(a is b for a, b in zip(duplicated["members"], Sentinel, strict=True))
+
+
+@DUPLICATORS
+def test_parameter_duplication(duplicate):
+    """A parameter's default is ``UNSET`` unless given, and survives copies."""
+    option = click.Option(["--name"])
+    assert option.default is UNSET
+
+    duplicated = duplicate(option)
+    assert duplicated.default is UNSET
+    assert duplicated.name == "name"
