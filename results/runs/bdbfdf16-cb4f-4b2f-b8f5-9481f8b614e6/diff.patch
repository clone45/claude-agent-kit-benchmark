+def _set_environ(key: str, value: str | None) -> None:
+    """Set ``os.environ[key]`` to *value*, or remove it if *value* is
+    ``None``.
+    """
+    if value is None:
+        try:
+            del os.environ[key]
+        except Exception:
+            pass
+    else:
+        os.environ[key] = value
+
