+@pytest.mark.parametrize("update_min_steps", [1, 3, 7, 19, 20, 21, 50])
+@pytest.mark.parametrize("mode", ["iterate", "update"])
+def test_progress_bar_update_min_steps_applies_remainder(
+    runner, monkeypatch, update_min_steps, mode
+):
+    """Steps held back by ``update_min_steps`` are applied when the bar
+    finishes, so the final position is reached and rendered.
+    """
+    bars = []
+
+    @click.command()
+    def cli():
+        with click.progressbar(
+            range(20), show_pos=True, update_min_steps=update_min_steps
+        ) as bar:
+            bars.append(bar)
+
+            if mode == "iterate":
+                for _ in bar:
+                    pass
+            else:
+                for _ in range(20):
+                    bar.update(1)
+
+    monkeypatch.setattr(click._termui_impl, "isatty", lambda _: True)
+    output = runner.invoke(cli, [], catch_exceptions=False).output
+    (bar,) = bars
+    assert bar.pos == 20
+    assert bar.finished
+    assert bar._completed_intervals == 0
+    assert "20/20" in output
+
+
 @pytest.mark.parametrize("key_char", ("h", "H", "é", "À", " ", "字", "àH", "àR"))
 @pytest.mark.parametrize("echo", [True, False])
 @pytest.mark.skipif(not WIN, reason="Tests user-input using the msvcrt module.")
