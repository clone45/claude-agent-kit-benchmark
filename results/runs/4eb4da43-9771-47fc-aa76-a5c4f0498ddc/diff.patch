+def _make_pdb_init(old_pdb_init: t.Callable[..., None]) -> t.Callable[..., None]:
+    """Wrap ``pdb.Pdb.__init__`` so it defaults to the real terminal
+    streams during :meth:`CliRunner.isolation`.
+    """
+
+    def _patched_pdb_init(
+        self: pdb.Pdb,
+        completekey: str = "tab",
+        stdin: t.IO[str] | None = None,
+        stdout: t.IO[str] | None = None,
+        **kwargs: t.Any,
+    ) -> None:
+        """Default ``pdb.Pdb`` to real terminal streams during
+        ``CliRunner`` isolation.
+
+        Without this patch, ``pdb.Pdb.__init__`` inherits from
+        ``cmd.Cmd`` which falls back to ``sys.stdin``/``sys.stdout``
+        when no explicit streams are provided. During isolation
+        those are ``BytesIO``-backed wrappers, so the debugger
+        reads from an empty buffer and writes to captured output,
+        making interactive debugging impossible.
+
+        By defaulting to ``sys.__stdin__``/``sys.__stdout__`` (the
+        original terminal streams Python preserves regardless of
+        redirection), debuggers can interact with the user while
+        ``click.echo`` output is still captured normally.
+
+        This covers ``pdb.set_trace()``, ``breakpoint()``,
+        ``pdb.post_mortem()``, and debuggers that subclass
+        ``pdb.Pdb`` (ipdb, pdbpp). Explicit ``stdin``/``stdout``
+        arguments are honored and not overridden. Debuggers that
+        do not subclass ``pdb.Pdb`` (pudb, debugpy) are not
+        covered.
+        """
+        if stdin is None:
+            stdin = sys.__stdin__
+        if stdout is None:
+            stdout = sys.__stdout__
+        old_pdb_init(
+            self, completekey=completekey, stdin=stdin, stdout=stdout, **kwargs
+        )
+
+    return _patched_pdb_init
+
+
+class _IsolatedStreams:
+    """The replacement standard streams, prompt functions and ANSI
+    stripping check that :meth:`CliRunner.isolation` installs.
+
+    :param bytes_input: the binary stream to read `<stdin>` from.
+    :param charset: the encoding of the text streams.
+    :param echo_stdin: echo what is read from `<stdin>` to `<stdout>`.
+    :param color: whether output keeps color codes by default.
+    """
+
+    def __init__(
+        self, bytes_input: t.BinaryIO, charset: str, echo_stdin: bool, color: bool
+    ) -> None:
+        self.mixer = StreamMixer()
+        self._echo_input: EchoingStdin | None = None
+        self._default_color = color
+
+        if echo_stdin:
+            echo_input = EchoingStdin(bytes_input, self.mixer.stdout)
+            self._echo_input = echo_input
+            bytes_input = t.cast(t.BinaryIO, echo_input)
+
+        self.stdin = _NamedTextIOWrapper(
+            bytes_input, encoding=charset, name="<stdin>", mode="r"
+        )
+
+        if echo_stdin:
+            # Force unbuffered reads, otherwise TextIOWrapper reads a
+            # large chunk which is echoed early.
+            self.stdin._CHUNK_SIZE = 1  # type: ignore
+
+        self.stdout = _NamedTextIOWrapper(
+            self.mixer.stdout,
+            encoding=charset,
+            name="<stdout>",
+            mode="w",
+        )
+
+        self.stderr = _NamedTextIOWrapper(
+            self.mixer.stderr,
+            encoding=charset,
+            name="<stderr>",
+            mode="w",
+            errors="backslashreplace",
+        )
+
+    def install(self, old_pdb_init: t.Callable[..., None]) -> None:
+        """Replace the standard streams and Click's prompt, getchar and
+        ANSI stripping hooks, and patch ``pdb.Pdb.__init__``.
+        """
+        sys.stdin = self.stdin
+        sys.stdout = self.stdout
+        sys.stderr = self.stderr
+        termui.visible_prompt_func = self.visible_input
+        termui.hidden_prompt_func = self.hidden_input
+        termui._getchar = self._getchar
+        utils.should_strip_ansi = self.should_strip_ansi  # type: ignore
+        _compat.should_strip_ansi = self.should_strip_ansi
+        pdb.Pdb.__init__ = _make_pdb_init(old_pdb_init)  # type: ignore[method-assign]
+
+    def visible_input(self, prompt: str | None = None) -> str:
+        with _pause_echo(self._echo_input):
+            sys.stdout.write(prompt or "")
+            try:
+                val = next(self.stdin).rstrip("\r\n")
+            except StopIteration as e:
+                raise EOFError() from e
+            sys.stdout.write(f"{val}\n")
+            sys.stdout.flush()
+            return val
+
+    def hidden_input(self, prompt: str | None = None) -> str:
+        with _pause_echo(self._echo_input):
+            sys.stdout.write(f"{prompt or ''}\n")
+            sys.stdout.flush()
+            try:
+                return next(self.stdin).rstrip("\r\n")
+            except StopIteration as e:
+                raise EOFError() from e
+
+    def _getchar(self, echo: bool) -> str:
+        with _pause_echo(self._echo_input):
+            char = sys.stdin.read(1)
+
+            if echo:
+                sys.stdout.write(char)
+
+            sys.stdout.flush()
+            return char
+
+    def should_strip_ansi(
+        self, stream: t.IO[t.Any] | None = None, color: bool | None = None
+    ) -> bool:
+        if color is None:
+            return not self._default_color
+        return not color
+
+
+class _SavedGlobals:
+    """Snapshot of the interpreter and Click globals that
+    :meth:`CliRunner.isolation` replaces, taken on creation.
+    """
+
+    def __init__(self) -> None:
+        self.stdin = sys.stdin
+        self.stdout = sys.stdout
+        self.stderr = sys.stderr
+        self.forced_width = formatting.FORCED_WIDTH
+        self.visible_prompt_func = termui.visible_prompt_func
+        self.hidden_prompt_func = termui.hidden_prompt_func
+        self.getchar = termui._getchar
+        self.utils_should_strip_ansi = utils.should_strip_ansi  # type: ignore
+        self.compat_should_strip_ansi = _compat.should_strip_ansi
+        self.pdb_init = pdb.Pdb.__init__
+
+    def restore(self) -> None:
+        """Put every saved global back."""
+        sys.stdout = self.stdout
+        sys.stderr = self.stderr
+        sys.stdin = self.stdin
+        termui.visible_prompt_func = self.visible_prompt_func
+        termui.hidden_prompt_func = self.hidden_prompt_func
+        termui._getchar = self.getchar
+        utils.should_strip_ansi = self.utils_should_strip_ansi  # type: ignore
+        _compat.should_strip_ansi = self.compat_should_strip_ansi
+        formatting.FORCED_WIDTH = self.forced_width
+        pdb.Pdb.__init__ = self.pdb_init  # type: ignore[method-assign]
+
+
+def _update_environ(
+    changes: cabc.Mapping[str, str | None],
+    old_values: dict[str, str | None] | None = None,
+) -> None:
+    """Apply ``changes`` to ``os.environ``, deleting keys whose value is
+    ``None``. If ``old_values`` is given, record each key's previous
+    value in it before changing that key.
+    """
+    for key, value in changes.items():
+        if old_values is not None:
+            old_values[key] = os.environ.get(key)
+        if value is None:
+            try:
+                del os.environ[key]
+            except Exception:
+                pass
+        else:
+            os.environ[key] = value
+
