@@ -3977,6 +3995,17 @@ class Argument(Parameter):
         return name, [arg], []
 
     def get_usage_pieces(self, ctx: Context) -> list[str]:
+        # A type like Choice or DateTime already brackets its metavar to
+        # enumerate the allowed values. For an optional argument those
+        # brackets serve as the optional marker, so they are not doubled.
+        if self.metavar is None and not self.required:
+            var = self.type.get_metavar(param=self, ctx=ctx)
+            if var and _is_bracketed(var):
+                if self.deprecated:
+                    var += "!"
+                if self.nargs != 1:
+                    var += "..."
+                return [var]
