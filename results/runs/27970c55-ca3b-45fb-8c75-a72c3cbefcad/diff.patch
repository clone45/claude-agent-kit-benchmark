@@ -832,6 +832,61 @@ def test_argument_metavar_marks_optional(runner, kwargs, expected):
     assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
 
 
+class _SplitBracketType(click.ParamType):
+    name = "split"
+
+    def get_metavar(self, param, ctx):
+        return "[a] [b]"
+
+
+@pytest.mark.parametrize(
+    ("type", "kwargs", "expected"),
+    [
+        (click.Choice(["foo", "bar", "baz"]), {}, "{foo|bar|baz}"),
+        (click.Choice(["foo", "bar", "baz"]), {"required": False}, "[foo|bar|baz]"),
+        (click.Choice(["foo", "bar", "baz"]), {"nargs": -1}, "[foo|bar|baz]..."),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"nargs": -1, "required": True},
+            "{foo|bar|baz}...",
+        ),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"nargs": 2, "required": False},
+            "[foo|bar|baz]...",
+        ),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"required": False, "deprecated": True},
+            "[foo|bar|baz]!",
+        ),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"required": False, "metavar": "THING"},
+            "THING",
+        ),
+        (click.DateTime(formats=["%Y-%m-%d"]), {"required": False}, "[%Y-%m-%d]"),
+        (click.DateTime(formats=["%Y-%m-%d"]), {}, "[%Y-%m-%d]"),
+        # The first bracket closes early, so the type's metavar is not one
+        # bracketed group and still gets the optional marker.
+        (_SplitBracketType(), {"required": False}, "[[a] [b]]"),
+    ],
+)
+def test_argument_bracketed_type_metavar_not_doubled(runner, type, kwargs, expected):
+    """A type that brackets its own metavar is not bracketed again when the
+    argument is optional.
+    """
+
+    @click.command()
+    @click.argument("foo", type=type, **kwargs)
+    def cli(foo):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
+
+
 @pytest.mark.parametrize(
     ("deprecated", "expected_label"),
     [(True, "(DEPRECATED)"), ("use g instead", "(DEPRECATED: use g instead)")],
