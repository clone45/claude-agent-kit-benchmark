@@ -146,6 +146,24 @@ def _format_deprecated_suffix(deprecated: bool | str) -> str:
     return ""
 
 
+def _is_bracketed(metavar: str) -> bool:
+    """Return whether ``metavar`` is wrapped in one pair of square brackets,
+    as in ``[foo|bar]``, where the first ``[`` is closed by the last ``]``.
+    ``[a] [b]`` is not, because its first bracket closes early.
+    """
+    if not (metavar.startswith("[") and metavar.endswith("]")):
+        return False
+    depth = 0
+    for char in metavar[:-1]:
+        if char == "[":
+            depth += 1
+        elif char == "]":
+            depth -= 1
+            if depth == 0:
+                return False
+    return depth == 1
+
