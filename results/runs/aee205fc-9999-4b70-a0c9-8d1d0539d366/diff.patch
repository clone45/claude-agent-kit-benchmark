+def _detect_package_name() -> str | None:
+    """Detect the top-level package name of the module that called
+    :func:`version_option` by inspecting the stack frames.
+    """
+    frame = inspect.currentframe()
+    # Go up two frames: past this function and past version_option.
+    f_back = frame.f_back if frame is not None else None
+    f_back = f_back.f_back if f_back is not None else None
+    f_globals = f_back.f_globals if f_back is not None else None
+    # break reference cycle
+    # https://docs.python.org/3/library/inspect.html#the-interpreter-stack
+    del frame
+
+    if f_globals is None:
+        return None
+
+    package_name: str | None = f_globals.get("__name__")
+
+    if package_name == "__main__":
+        package_name = f_globals.get("__package__")
+
+    if package_name:
+        package_name = package_name.partition(".")[0]
+
+    return package_name
+
+
+def _resolve_version(
+    package_name: str | None, version: str | None
+) -> tuple[str | None, str]:
+    """Return the ``(package_name, version)`` to show for
+    :func:`version_option`.
+
+    If ``version`` is not given, it is looked up with
+    :func:`importlib.metadata.version`. If ``package_name`` is not an
+    installed distribution, it is resolved as an import (top-level
+    module) name, and the returned package name is the distribution's.
+
+    :raise RuntimeError: ``version`` could not be determined.
+    """
+    if version is None and package_name is not None:
+        import importlib.metadata
+
+        try:
+            version = importlib.metadata.version(package_name)
+        except importlib.metadata.PackageNotFoundError:
+            # The given name didn't match an installed distribution.
+            # Try resolving it as an import (top-level module) name,
+            # e.g. ``PIL`` is provided by the ``Pillow`` distribution.
+            distributions = importlib.metadata.packages_distributions().get(
+                package_name, []
+            )
+            if len(distributions) == 1:
+                package_name = distributions[0]
+                version = importlib.metadata.version(package_name)
+            elif len(distributions) > 1:
+                raise RuntimeError(
+                    f"{package_name!r} maps to multiple installed"
+                    f" distributions ({', '.join(distributions)})."
+                    " Pass 'package_name' to disambiguate."
+                ) from None
+            else:
+                raise RuntimeError(
+                    f"{package_name!r} is not installed. Try passing"
+                    " 'package_name' instead."
+                ) from None
+
+    if version is None:
+        raise RuntimeError(
+            f"Could not determine the version for {package_name!r} automatically."
+        )
+
+    return package_name, version
+
+
+def _version_callback(
+    version: str | None, package_name: str | None, prog_name: str | None, message: str
+) -> t.Callable[[Context, Parameter, bool], None]:
+    """Create the callback for :func:`version_option` that prints the version message
+    and exits. The detected values are remembered for later invocations.
+    """
+
+    def callback(ctx: Context, param: Parameter, value: bool) -> None:
+        if not value or ctx.resilient_parsing:
+            return
+
+        nonlocal prog_name, version, package_name
+
+        if prog_name is None:
+            prog_name = ctx.find_root().info_name
+
+        package_name, version = _resolve_version(package_name, version)
+        values = {"prog": prog_name, "package": package_name, "version": version}
+        echo(message % values, color=ctx.color)
+        ctx.exit()
+
+    return callback
+
+
