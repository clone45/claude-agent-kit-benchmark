+def _detect_package_name() -> str | None:
+    """Detect the top-level package name of the module that called
+    :func:`version_option` by inspecting the stack.
+
+    Must be called directly from :func:`version_option`, since it looks
+    two frames up: past itself and past :func:`version_option`.
+    """
+    frame = inspect.currentframe()
+    version_option_frame = frame.f_back if frame is not None else None
+    caller = version_option_frame.f_back if version_option_frame is not None else None
+    f_globals = caller.f_globals if caller is not None else None
+    # break reference cycle
+    # https://docs.python.org/3/library/inspect.html#the-interpreter-stack
+    del frame, version_option_frame, caller
+
+    if f_globals is None:
+        return None
+
+    package_name: str | None = f_globals.get("__name__")
+
+    if package_name == "__main__":
+        package_name = f_globals.get("__package__")
+
+    if package_name:
+        package_name = package_name.partition(".")[0]
+
+    return package_name
+
+
+def _resolve_distribution_name(import_name: str) -> str:
+    """Resolve an import (top-level module) name to the single installed
+    distribution that provides it, e.g. ``PIL`` to ``Pillow``.
+
+    :raise RuntimeError: No distribution, or more than one, provides it.
+    """
+    import importlib.metadata
+
+    distributions = importlib.metadata.packages_distributions().get(import_name, [])
+
+    if len(distributions) == 1:
+        return distributions[0]
+
+    if len(distributions) > 1:
+        raise RuntimeError(
+            f"{import_name!r} maps to multiple installed"
+            f" distributions ({', '.join(distributions)})."
+            " Pass 'package_name' to disambiguate."
+        ) from None
+
+    raise RuntimeError(
+        f"{import_name!r} is not installed. Try passing 'package_name' instead."
+    ) from None
+
+
+def _version_callback(
+    version: str | None,
+    package_name: str | None,
+    prog_name: str | None,
+    message: str | None,
+) -> t.Callable[[Context, Parameter, bool], None]:
+    """Build the callback for :func:`version_option`. The program name,
+    package name, and version are detected on first use and remembered
+    for later invocations.
+    """
+    if message is None:
+        message = _("%(prog)s, version %(version)s")
+
+    def callback(ctx: Context, param: Parameter, value: bool) -> None:
+        if not value or ctx.resilient_parsing:
+            return
+
+        nonlocal prog_name
+        nonlocal version
+        nonlocal package_name
+
+        if prog_name is None:
+            prog_name = ctx.find_root().info_name
+
+        if version is None and package_name is not None:
+            import importlib.metadata
+
+            try:
+                version = importlib.metadata.version(package_name)
+            except importlib.metadata.PackageNotFoundError:
+                # The given name didn't match an installed distribution.
+                # Try resolving it as an import (top-level module) name.
+                package_name = _resolve_distribution_name(package_name)
+                version = importlib.metadata.version(package_name)
+
+        if version is None:
+            raise RuntimeError(
+                f"Could not determine the version for {package_name!r} automatically."
+            )
+
+        echo(
+            message % {"prog": prog_name, "package": package_name, "version": version},
+            color=ctx.color,
+        )
+        ctx.exit()
+
+    return callback
+
+
