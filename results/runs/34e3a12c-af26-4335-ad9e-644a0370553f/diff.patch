     result = runner.invoke(cli, ["a/b/c.txt"], standalone_mode=False)
     assert result.exception is None
     assert result.return_value == expect
+
+
+def test_path_subscript_at_runtime():
+    """``Path`` is generic over its converted value type, and the explicit
+    annotation ``Path[pathlib.Path]`` is valid at runtime."""
+    assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+    path_type = click.Path(path_type=pathlib.Path)
+    assert path_type(pathlib.PurePosixPath("a/b.txt")) == pathlib.Path("a/b.txt")
+    assert path_type(None) is None
diff --git a/tests/typing/typing_path.py b/tests/typing/typing_path.py
new file mode 100644
index 0000000..020af6b
--- /dev/null
+++ b/tests/typing/typing_path.py
@@ -0,0 +1,39 @@
+import os
+import pathlib
+
+from typing_extensions import assert_type
+
+import click
+
+# Without ``path_type``, the value is any of the types Path may return.
+default_path = click.Path()
+assert_type(default_path, click.Path[str | bytes | os.PathLike[str]])
+assert_type(default_path.convert("a/b.txt", None, None), str | bytes | os.PathLike[str])
+assert_type(default_path("a/b.txt"), str | bytes | os.PathLike[str])
+
+# The ``path_type`` argument narrows the converted value type.
+pathlib_path = click.Path(path_type=pathlib.Path)
+assert_type(pathlib_path, click.Path[pathlib.Path])
+assert_type(pathlib_path.convert("a/b.txt", None, None), pathlib.Path)
+assert_type(pathlib_path.coerce_path_result("a/b.txt"), pathlib.Path)
+assert_type(pathlib_path("a/b.txt"), pathlib.Path)
+assert_type(pathlib_path(pathlib.PurePosixPath("a/b.txt")), pathlib.Path)
+assert_type(pathlib_path(None), None)
+
+assert_type(click.Path(path_type=str).convert("a/b.txt", None, None), str)
+assert_type(click.Path(path_type=bytes).convert("a/b.txt", None, None), bytes)
+assert_type(
+    click.Path(exists=True, path_type=None)("a/b.txt"), str | bytes | os.PathLike[str]
+)
+
+# An explicit annotation is accepted.
+explicit: click.Path[pathlib.Path] = click.Path(path_type=pathlib.Path)
+assert_type(explicit.convert("a/b.txt", None, None), pathlib.Path)
+
+# Path is assignable to the ParamType of its converted value type.
+pathlib_param_type: click.ParamType[pathlib.Path] = click.Path(path_type=pathlib.Path)
+default_param_type: click.ParamType[str | bytes | os.PathLike[str]] = click.Path()
+
+# The return type of prompt is narrowed by the Path's value type.
+assert_type(click.prompt("File", type=click.Path(path_type=pathlib.Path)), pathlib.Path)
+assert_type(click.prompt("File", type=click.Path()), str | bytes | os.PathLike[str])
