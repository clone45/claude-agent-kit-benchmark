+@pytest.mark.parametrize(
+    ("help_names", "params", "expected"),
+    [
+        (["-h", "--help"], [], ["-h", "--help"]),
+        (["--help", "-h", "-?"], [], ["--help", "-h", "-?"]),
+        (["-h", "--help", "-h"], [], ["-h", "--help"]),
+        (["-h", "--help"], [click.Option(["--help", "-x"])], ["-h"]),
+        (
+            ["--no-shout", "--help"],
+            [click.Option(["--shout/--no-shout"])],
+            ["--help"],
+        ),
+        (["--shout", "--help"], [click.Option(["--shout/--no-shout"])], ["--help"]),
+        (["-h", "--help"], [click.Option(["-h", "--help"])], []),
+    ],
+    ids=[
+        "declared-order",
+        "declared-order-unsorted",
+        "duplicates",
+        "option-collision",
+        "secondary-opts-collision",
+        "primary-opts-collision",
+        "all-filtered",
+    ],
+)
+def test_help_option_names_order(help_names, params, expected):
+    """Help option names keep their declared order, drop duplicates, and
+    exclude names claimed by other parameters.
+    """
+    cli = click.Command("cli", params=params)
+    ctx = click.Context(cli, help_option_names=help_names)
+    assert cli.get_help_option_names(ctx) == expected
+
+
+def test_help_option_names_all_filtered_no_help_option():
+    """When every help name is taken, no help option is added."""
+    cli = click.Command("cli", params=[click.Option(["-h", "--help"])])
+    ctx = click.Context(cli, help_option_names=["-h", "--help"])
+    assert cli.get_help_option(ctx) is None
+
+
+def test_help_option_names_order_in_help_option():
+    """The generated help option receives its names in declared order."""
+    cli = click.Command("cli")
+    ctx = click.Context(cli, help_option_names=["--help", "-h", "-?"])
+    help_option = cli.get_help_option(ctx)
+    assert help_option is not None
+    assert help_option.opts == ["--help", "-h", "-?"]
+
