+import copy
+import pickle
 from decimal import Decimal
 from fractions import Fraction
 
+import pytest
+
+import click
+from click._utils import Sentinel
 from click._utils import UNSET
 
 
@@ -50,3 +56,39 @@ def test_unset_sentinel():
         assert value is not real_value
 
     assert value not in real_values
+
+
+@pytest.mark.parametrize("sentinel", list(Sentinel))
+def test_sentinel_copy_is_identity(sentinel):
+    assert copy.copy(sentinel) is sentinel
+    assert copy.deepcopy(sentinel) is sentinel
+
+
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+@pytest.mark.parametrize("sentinel", list(Sentinel))
+def test_sentinel_pickle_is_identity(sentinel, protocol):
+    assert pickle.loads(pickle.dumps(sentinel, protocol=protocol)) is sentinel
+
+
+def test_sentinel_identity_preserved_in_containers():
+    data = {"a": UNSET, "b": [UNSET, Sentinel.FLAG_NEEDS_VALUE]}
+
+    for result in (copy.deepcopy(data), pickle.loads(pickle.dumps(data))):
+        assert result["a"] is UNSET
+        assert result["b"][0] is UNSET
+        assert result["b"][1] is Sentinel.FLAG_NEEDS_VALUE
+
+
+@pytest.mark.parametrize(
+    "clone",
+    [copy.copy, copy.deepcopy, lambda obj: pickle.loads(pickle.dumps(obj))],
+    ids=["copy", "deepcopy", "pickle"],
+)
+def test_option_default_unset_survives_clone(clone):
+    option = click.Option(["--name"])
+    assert option.default is UNSET
+
+    cloned = clone(option)
+
+    assert cloned.default is UNSET
+    assert cloned.name == "name"
