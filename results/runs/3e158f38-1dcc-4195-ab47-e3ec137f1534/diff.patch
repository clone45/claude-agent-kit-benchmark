+
+
+def _pickle_round_trip(protocol):
+    def round_trip(value):
+        return pickle.loads(pickle.dumps(value, protocol=protocol))
+
+    return round_trip
+
+
+ROUND_TRIPS = pytest.mark.parametrize(
+    "round_trip",
+    [
+        pytest.param(copy.copy, id="copy"),
+        pytest.param(copy.deepcopy, id="deepcopy"),
+        *(
+            pytest.param(_pickle_round_trip(protocol), id=f"pickle-{protocol}")
+            for protocol in range(pickle.HIGHEST_PROTOCOL + 1)
+        ),
+    ],
+)
+
+
+@ROUND_TRIPS
+@pytest.mark.parametrize("member", list(Sentinel), ids=lambda m: m.name)
+def test_sentinel_round_trip_is_identity(round_trip, member):
+    assert round_trip(member) is member
+
+
+@ROUND_TRIPS
+def test_sentinel_identity_preserved_in_container(round_trip):
+    value = {"a": UNSET, "b": [UNSET, Sentinel.FLAG_NEEDS_VALUE]}
+    result = round_trip(value)
+
+    assert result["a"] is UNSET
+    assert result["b"][0] is UNSET
+    assert result["b"][1] is Sentinel.FLAG_NEEDS_VALUE
+
+
+@ROUND_TRIPS
+def test_option_default_unset_survives_round_trip(round_trip):
+    option = click.Option(["--name"])
+    assert option.default is UNSET
+
+    result = round_trip(option)
+
+    assert result is not option
+    assert result.default is UNSET
+    assert result.name == "name"
