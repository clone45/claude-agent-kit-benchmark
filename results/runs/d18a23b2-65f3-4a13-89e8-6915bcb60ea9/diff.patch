diff --git a/src/click/_utils.py b/src/click/_utils.py
index 05ee2e9..6cbf47b 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -3,21 +3,44 @@ from __future__ import annotations
 import enum
 import typing as t
 
+if t.TYPE_CHECKING:
+    import typing_extensions as te
 
+
+@enum.unique
 class Sentinel(enum.Enum):
     """Enum used to define sentinel values.
 
+    Each member is a singleton: copying, deep-copying, or pickling and
+    unpickling a member returns the very same member object.
+
+    Member values are opaque UUIDs, minted once and never changed. They
+    are what a pickle stores to find the member again, so they must stay
+    stable even if a member is renamed. ``@enum.unique`` rejects
+    duplicates, which would otherwise silently alias two members.
+
     .. seealso::
 
         `PEP 661 - Sentinel Values <https://peps.python.org/pep-0661/>`_.
     """
 
-    UNSET = object()
-    FLAG_NEEDS_VALUE = object()
+    UNSET = "2b2a8486-cfd1-4383-9de6-cd0608f1c309"
+    FLAG_NEEDS_VALUE = "2421e8d5-caa9-4b63-8cba-402444f2e38a"
 
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __copy__(self) -> te.Self:
+        return self
+
+    def __deepcopy__(self, memo: t.Any) -> te.Self:
+        return self
+
+    def __reduce_ex__(self, protocol: object) -> tuple[t.Any, ...]:
+        # Unpickling calls ``Sentinel(value)``, which looks up the
+        # existing member by its frozen UUID value.
+        return self.__class__, (self._value_,)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
