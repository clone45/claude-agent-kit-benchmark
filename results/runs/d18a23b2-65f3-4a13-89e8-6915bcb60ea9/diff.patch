+import copy
+import pickle
 from decimal import Decimal
 from fractions import Fraction
 
+import pytest
+
+import click
+from click._utils import Sentinel
 from click._utils import UNSET
 
+ROUND_TRIPS = [
+    pytest.param(copy.copy, id="copy"),
+    pytest.param(copy.deepcopy, id="deepcopy"),
+    *(
+        pytest.param(
+            lambda obj, protocol=protocol: pickle.loads(pickle.dumps(obj, protocol)),
+            id=f"pickle-protocol-{protocol}",
+        )
+        for protocol in range(pickle.HIGHEST_PROTOCOL + 1)
+    ),
+]
+
 
 def test_unset_sentinel():
     value = UNSET
@@ -50,3 +68,35 @@ def test_unset_sentinel():
         assert value is not real_value
 
     assert value not in real_values
+
+
+@pytest.mark.parametrize("round_trip", ROUND_TRIPS)
+@pytest.mark.parametrize("member", list(Sentinel))
+def test_sentinel_round_trip_is_identity(member, round_trip):
+    assert round_trip(member) is member
+
+
+@pytest.mark.parametrize("round_trip", ROUND_TRIPS)
+def test_sentinel_round_trip_inside_container(round_trip):
+    members = list(Sentinel)
+    result = round_trip({"members": members})
+
+    for original, copied in zip(members, result["members"], strict=True):
+        assert copied is original
+
+
+@pytest.mark.parametrize("round_trip", ROUND_TRIPS)
+def test_option_default_unset_survives_round_trip(round_trip):
+    option = click.Option(["--name"])
+    assert option.default is UNSET
+
+    result = round_trip(option)
+
+    assert result is not option
+    assert result.default is UNSET
+    assert result.name == "name"
+
+
+def test_sentinel_values_are_unique():
+    values = [member.value for member in Sentinel]
+    assert len(values) == len(set(values))
