+@pytest.mark.parametrize("update_min_steps", [1, 3, 7, 19, 20, 21, 100])
+@pytest.mark.parametrize("drive", ["iterate", "update"])
+def test_progress_bar_update_min_steps_final_position(
+    runner, monkeypatch, update_min_steps, drive
+):
+    """Steps held back by update_min_steps are applied and rendered when
+    the bar finishes, even if the length is not a multiple of the threshold.
+    """
+    monkeypatch.setattr(click._termui_impl, "isatty", lambda _: True)
+    file = io.StringIO()
+
+    with click.progressbar(
+        length=20, show_pos=True, update_min_steps=update_min_steps, file=file
+    ) as bar:
+        if drive == "iterate":
+            for _ in bar:
+                pass
+        else:
+            for _ in range(20):
+                bar.update(1)
+
+    assert bar.pos == 20
+    assert bar.finished
+    assert bar._completed_intervals == 0
+    assert "20/20" in file.getvalue()
+
+
 @pytest.mark.parametrize("key_char", ("h", "H", "é", "À", " ", "字", "àH", "àR"))
 @pytest.mark.parametrize("echo", [True, False])
 @pytest.mark.skipif(not WIN, reason="Tests user-input using the msvcrt module.")
