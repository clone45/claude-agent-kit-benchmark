diff --git a/tests/test_commands.py b/tests/test_commands.py
index c2de826..a9e59e9 100644
--- a/tests/test_commands.py
+++ b/tests/test_commands.py
@@ -698,3 +698,94 @@ def test_suggest_possible_commands(runner, value, expect):
 
     result = runner.invoke(cli, [value])
     assert expect in result.output
+
+
+def test_help_option_reserved_name():
+    cli = click.Command("cli")
+    ctx = click.Context(cli)
+    assert cli.get_help_option(ctx).name == "_click_default_help"
+
+
+def test_help_argument_does_not_collide(runner):
+    def callback(**kwargs):
+        click.echo(repr(kwargs))
+
+    cli = click.Command("cli", params=[click.Argument(["help"])], callback=callback)
+    result = runner.invoke(cli, ["value"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "{'help': 'value'}\n"
+
+
+def test_help_named_option_does_not_collide(runner):
+    def callback(**kwargs):
+        click.echo(repr(kwargs))
+
+    cli = click.Command(
+        "cli", params=[click.Option(["--assist", "help"])], callback=callback
+    )
+    result = runner.invoke(cli, ["--assist", "value"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "{'help': 'value'}\n"
+
+
+@pytest.mark.parametrize("help_option_names", [["--help"], ["--man"], ["/?"]])
+def test_help_option_names_still_show_help(runner, help_option_names):
+    cli = click.Command(
+        "cli",
+        params=[click.Argument(["help"], required=False)],
+        context_settings={"help_option_names": help_option_names},
+    )
+    result = runner.invoke(cli, [help_option_names[0]])
+    assert result.exit_code == 0, result.output
+    assert "Show this message and exit." in result.output
+    assert help_option_names[0] in result.output
+
+
+def test_argument_name_collision_warns():
+    cli = click.Command(
+        "cli", params=[click.Argument(["name"]), click.Option(["--name"])]
+    )
+    ctx = click.Context(cli)
+
+    with pytest.warns(
+        UserWarning, match="'name' is used by an argument.*overwrite each other's"
+    ):
+        cli.get_params(ctx)
+
+
+def test_reserved_help_name_warns():
+    cli = click.Command("cli", params=[click.Option(["--x", "_click_default_help"])])
+    ctx = click.Context(cli)
+
+    with pytest.warns(UserWarning, match="reserved for the automatic help option"):
+        cli.get_params(ctx)
+
+
+def test_shared_option_name_does_not_warn(runner):
+    @click.command()
+    @click.option("--upper", "transformation", flag_value="upper")
+    @click.option("--lower", "transformation", flag_value="lower")
+    def cli(transformation):
+        click.echo(transformation)
+
+    result = runner.invoke(cli, ["--upper"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "upper\n"
+
+
+def test_help_flag_reused_by_user_option(runner):
+    @click.command()
+    @click.option("--help", default="default value")
+    def cli(help):
+        click.echo(help)
+
+    assert cli.get_help_option(click.Context(cli)) is None
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0, result.output
+    assert result.output == "default value\n"
+
+    result = runner.invoke(cli, ["--help", "given"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "given\n"
+    assert "Show this message and exit." not in result.output
