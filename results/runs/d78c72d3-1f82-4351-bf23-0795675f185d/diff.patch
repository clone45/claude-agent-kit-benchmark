diff --git a/src/click/_utils.py b/src/click/_utils.py
index 05ee2e9..7d8727c 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,18 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    # Members are singletons. The default Enum reduction looks members up by
+    # value, which is a bare ``object()`` that does not survive a round trip,
+    # so resolve them by member name on the class instead.
+    def __reduce_ex__(self, proto: object) -> tuple[t.Any, ...]:
+        return getattr, (self.__class__, self._name_)
+
+    def __copy__(self) -> Sentinel:
+        return self
+
+    def __deepcopy__(self, memo: dict[int, t.Any]) -> Sentinel:
+        return self
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
diff --git a/tests/test_utils/test_sentinel.py b/tests/test_utils/test_sentinel.py
