diff --git a/tests/test_types/test_Duration.py b/tests/test_types/test_Duration.py
new file mode 100644
index 0000000..ecaeb62
--- /dev/null
+++ b/tests/test_types/test_Duration.py
@@ -0,0 +1,99 @@
+from datetime import timedelta
+
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("5m", timedelta(minutes=5)),
+        ("1h30m", timedelta(minutes=90)),
+        ("1h 30m", timedelta(minutes=90)),
+        ("2d", timedelta(days=2)),
+        ("1D2H3M4S", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1d 2h 3m 4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1d4s", timedelta(days=1, seconds=4)),
+        ("45", timedelta(seconds=45)),
+        ("  1h  ", timedelta(hours=1)),
+        ("0s", timedelta(0)),
+        ("0", timedelta(0)),
+        (45, timedelta(seconds=45)),
+        (0, timedelta(0)),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_timedelta_unchanged():
+    value = timedelta(hours=-3)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "   ",
+        "5x",
+        "1.5h",
+        "-5s",
+        "-5",
+        "+5s",
+        "30m1h",
+        "1h1h",
+        "h",
+        "abc",
+        "1 h",
+        "1h30",
+        "٣s",
+        f"{'9' * 30}d",
+        -5,
+        True,
+        1.5,
+        None,
+        [],
+    ],
+)
+def test_convert_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert repr(value) in exc_info.value.message
+
+
+def test_repr():
+    assert repr(click.Duration()) == "DURATION"
+
+
+def test_option(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, ["--timeout", "1h 30m"])
+    assert result.exception is None
+    assert result.output == f"{timedelta(minutes=90)!r}\n"
+
+    result = runner.invoke(cli, ["--timeout", "30m1h"])
+    assert result.exit_code == 2
+    assert "Invalid value for '--timeout': '30m1h' is not a valid duration." in (
+        result.output
+    )
+
+    result = runner.invoke(cli, ["--help"])
+    assert "--timeout DURATION" in result.output
+
+
+def test_option_default(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default="5m")
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, [])
+    assert result.output == f"{timedelta(minutes=5)!r}\n"
