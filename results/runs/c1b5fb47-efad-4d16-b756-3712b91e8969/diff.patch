+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings such as ``1h30m`` into
+    :class:`datetime.timedelta` objects.
+
+    A duration is one or more groups, each a non-negative integer followed
+    by a unit: ``d`` for days, ``h`` for hours, ``m`` for minutes, and ``s``
+    for seconds. Groups must appear in that order, each unit at most once.
+    Units are case-insensitive and groups may be separated by whitespace,
+    so ``90s``, ``5m``, ``1h30m``, ``1h 30m``, and ``2D`` are all valid. A
+    bare integer such as ``45`` is a number of seconds.
+
+    An :class:`int` value is treated as a number of seconds, and a
+    :class:`~datetime.timedelta` value is returned unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"""
+        (?:(?P<days>\d+)d)?\s*
+        (?:(?P<hours>\d+)h)?\s*
+        (?:(?P<minutes>\d+)m)?\s*
+        (?:(?P<seconds>\d+)s)?
+        """,
+        re.ASCII | re.IGNORECASE | re.VERBOSE,
+    )
+
+    def convert(
+        self,
+        value: timedelta | int | str,
+        param: Parameter | None,
+        ctx: Context | None,
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        parts: dict[str, int] | None = None
+
+        # bool is a subclass of int, but True is not a sensible duration.
+        if isinstance(value, int) and not isinstance(value, bool):
+            if value >= 0:
+                parts = {"seconds": value}
+        elif isinstance(value, str):
+            parts = self._parse(value.strip())
+
+        if parts is not None:
+            try:
+                return timedelta(**parts)
+            except OverflowError:
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def _parse(self, value: str) -> dict[str, int] | None:
+        try:
+            if value.isascii() and value.isdigit():
+                return {"seconds": int(value)}
+
+            match = self._pattern.fullmatch(value)
+
+            if match is None:
+                return None
+
+            parts = {k: int(v) for k, v in match.groupdict().items() if v is not None}
+        except ValueError:
+            # int() refuses strings longer than sys.get_int_max_str_digits().
+            return None
+
+        # Every group is optional, so the pattern also matches "".
+        return parts or None
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
