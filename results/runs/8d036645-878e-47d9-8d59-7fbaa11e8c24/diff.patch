+
+
+def test_path_allow_dash_no_bytes_warning():
+    """Detecting the dash must not compare bytes with str. ``-bb`` turns
+    ``BytesWarning`` into an error, so run the check in a subprocess.
+    """
+    code = textwrap.dedent(
+        """
+        import click
+
+        path = click.Path(allow_dash=True)
+
+        for value in ("-", "", b"-", b""):
+            assert path.convert(value, None, None) == value
+        """
+    )
+    result = subprocess.run(
+        [sys.executable, "-bb", "-c", code], capture_output=True, text=True
+    )
+    assert result.returncode == 0, result.stderr
