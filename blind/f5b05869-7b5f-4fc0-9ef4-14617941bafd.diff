+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings such as ``90s``, ``5m``,
+    ``1h30m``, or ``2d`` into :class:`datetime.timedelta` objects.
+
+    A string is one or more groups of a non-negative integer followed by
+    a unit: ``d`` for days, ``h`` for hours, ``m`` for minutes, and ``s``
+    for seconds. Groups must appear in that order, each unit at most
+    once, and may be separated by whitespace. Units are
+    case-insensitive. A bare integer with no unit is a number of
+    seconds, as is an ``int`` value. A ``timedelta`` value is returned
+    unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?\s*"
+        r"(?:(?P<hours>[0-9]+)h)?\s*"
+        r"(?:(?P<minutes>[0-9]+)m)?\s*"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.IGNORECASE | re.ASCII,
+    )
+
+    def _fail_invalid(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> t.NoReturn:
+        self.fail(
+            _(
+                "{value!r} is not a valid duration. Use a whole number of"
+                " seconds or units like '1h30m' (d, h, m, s)."
+            ).format(value=value),
+            param,
+            ctx,
+        )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        # bool is a subclass of int, but True is not a meaningful duration.
+        if isinstance(value, int) and not isinstance(value, bool):
+            if value < 0:
+                self._fail_invalid(value, param, ctx)
+
+            parts = {"seconds": value}
+        elif isinstance(value, str):
+            text = value.strip()
+
+            if text.isascii() and text.isdigit():
+                parts = {"seconds": int(text)}
+            else:
+                match = self._pattern.fullmatch(text)
+
+                # The empty string matches with every group absent.
+                if match is None or not any(match.groups()):
+                    self._fail_invalid(value, param, ctx)
+
+                parts = {k: int(v) for k, v in match.groupdict().items() if v}
+        else:
+            self._fail_invalid(value, param, ctx)
+
+        try:
+            return timedelta(**parts)
+        except OverflowError:
+            self.fail(
+                _("{value!r} is too large a duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
