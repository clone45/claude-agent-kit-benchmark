diff --git a/tests/test_types/test_Duration.py b/tests/test_types/test_Duration.py
new file mode 100644
index 0000000..ea948d4
--- /dev/null
+++ b/tests/test_types/test_Duration.py
@@ -0,0 +1,158 @@
+import datetime
+
+import pytest
+
+import click
+
+td = datetime.timedelta
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", td(seconds=90)),
+        ("5m", td(minutes=5)),
+        ("1h30m", td(minutes=90)),
+        ("1h 30m", td(minutes=90)),
+        ("2d", td(days=2)),
+        ("1D2H3M4S", td(days=1, hours=2, minutes=3, seconds=4)),
+        ("1d 2h 3m 4s", td(days=1, hours=2, minutes=3, seconds=4)),
+        ("1d4s", td(days=1, seconds=4)),
+        ("  1h  ", td(hours=1)),
+        ("45", td(seconds=45)),
+        (" 45 ", td(seconds=45)),
+        ("0s", td(0)),
+        ("0", td(0)),
+        (45, td(seconds=45)),
+        (0, td(0)),
+        (td(hours=3), td(hours=3)),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_timedelta_returned_unchanged():
+    value = td(minutes=7)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "   ",
+        "5x",
+        "1.5h",
+        "-5s",
+        "-5",
+        "30m1h",
+        "1h1h",
+        "1s1m",
+        "h",
+        "abc",
+        "1h30",
+        "1 h",
+        "+5s",
+        "5ſ",  # LATIN SMALL LETTER LONG S casefolds to "s".
+        "٣s",  # ARABIC-INDIC DIGIT THREE
+        -5,
+        1.5,
+        True,
+        None,
+        [1],
+    ],
+)
+def test_convert_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert repr(value) in exc_info.value.message
+
+
+def test_convert_overflow():
+    with pytest.raises(click.BadParameter, match="too large"):
+        click.Duration().convert("9999999999d", None, None)
+
+
+def test_fail_uses_fail_method(monkeypatch):
+    calls = []
+    duration = click.Duration()
+
+    def fail(message, param=None, ctx=None):
+        calls.append(message)
+        raise click.BadParameter(message)
+
+    monkeypatch.setattr(duration, "fail", fail)
+
+    with pytest.raises(click.BadParameter):
+        duration.convert("5x", None, None)
+
+    assert len(calls) == 1
+    assert "'5x'" in calls[0]
+
+
+def test_attributes():
+    duration = click.Duration()
+    assert duration.name == "duration"
+    assert repr(duration) == "DURATION"
+    assert duration.to_info_dict() == {"param_type": "Duration", "name": "duration"}
+
+
+def test_option(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, ["--timeout", "1h 30m"])
+    assert not result.exception
+    assert result.output == f"{td(minutes=90)!r}\n"
+
+    result = runner.invoke(cli, ["--timeout", "45"])
+    assert result.output == f"{td(seconds=45)!r}\n"
+
+    result = runner.invoke(cli, [])
+    assert result.output == "None\n"
+
+
+def test_option_invalid(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        pass
+
+    result = runner.invoke(cli, ["--timeout", "30m1h"])
+    assert result.exit_code == 2
+    assert "Invalid value for '--timeout'" in result.output
+    assert "'30m1h' is not a valid duration" in result.output
+
+
+def test_option_default(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default="5m")
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, [])
+    assert result.output == f"{td(minutes=5)!r}\n"
+
+
+def test_option_help_metavar(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert "--timeout DURATION" in result.output
+
+
+def test_argument_metavar(runner):
+    @click.command()
+    @click.argument("timeout", type=click.Duration())
+    def cli(timeout):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert "Usage: cli [OPTIONS] TIMEOUT" in result.output
