+
+def test_path_allow_dash_no_bytes_warning():
+    """Detecting the dash must not compare bytes with str, which raises
+    ``BytesWarning`` under ``python -bb``.
+    """
+    code = (
+        "import click\n"
+        "for v in ('-', '', b'-', b''):\n"
+        "    click.Path(allow_dash=True).convert(v, None, None)\n"
+    )
+    result = subprocess.run(
+        [sys.executable, "-bb", "-W", "error::BytesWarning", "-c", code],
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, result.stderr
+    assert "BytesWarning" not in result.stderr
