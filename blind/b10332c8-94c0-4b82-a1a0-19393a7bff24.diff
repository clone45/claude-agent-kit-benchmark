diff --git a/src/click/_utils.py b/src/click/_utils.py
index 05ee2e9..abaa235 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -4,20 +4,35 @@ import enum
 import typing as t
 
 
+@enum.unique
 class Sentinel(enum.Enum):
     """Enum used to define sentinel values.
 
+    Each member's value is an opaque UUID, minted once and never changed. It
+    is the member's persistent identity: pickling stores it, and unpickling
+    looks the existing member up by it. Copying and unpickling always return
+    the very same member object, so ``is`` checks keep working.
+
     .. seealso::
 
         `PEP 661 - Sentinel Values <https://peps.python.org/pep-0661/>`_.
     """
 
-    UNSET = object()
-    FLAG_NEEDS_VALUE = object()
+    UNSET = "01012911-6591-427b-850d-e61b746dcb14"
+    FLAG_NEEDS_VALUE = "e6f0c775-c720-49ab-841f-a2ff3e03a2a2"
 
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __copy__(self) -> Sentinel:
+        return self
+
+    def __deepcopy__(self, memo: dict[int, t.Any]) -> Sentinel:
+        return self
+
+    def __reduce_ex__(self, protocol: object) -> tuple[t.Any, ...]:
+        return self.__class__, (self._value_,)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
