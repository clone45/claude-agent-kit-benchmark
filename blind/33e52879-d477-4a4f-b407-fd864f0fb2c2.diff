+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings such as ``1h30m`` into
+    :class:`datetime.timedelta` objects.
+
+    A duration is one or more groups of a non-negative integer followed
+    by a unit: ``d`` for days, ``h`` for hours, ``m`` for minutes, and
+    ``s`` for seconds. Units must appear in that order and each at most
+    once. Units are case-insensitive and groups may be separated by
+    whitespace. A bare integer with no unit is a number of seconds.
+
+    For example, ``90s``, ``5m``, ``1h30m``, ``1h 30m``, ``2d``, and
+    ``45`` are all valid.
+
+    An ``int`` value is treated as a number of seconds, and a
+    ``timedelta`` value is returned unchanged.
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>[0-9]+)d)?\s*"
+        r"(?:(?P<hours>[0-9]+)h)?\s*"
+        r"(?:(?P<minutes>[0-9]+)m)?\s*"
+        r"(?:(?P<seconds>[0-9]+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def _parse(self, value: str) -> timedelta | None:
+        value = value.strip()
+
+        if not value:
+            return None
+
+        if value.isascii() and value.isdigit():
+            return timedelta(seconds=int(value))
+
+        match = self._pattern.fullmatch(value)
+
+        if match is None:
+            return None
+
+        parts = {k: int(v) for k, v in match.groupdict().items() if v is not None}
+
+        # The pattern also matches the empty string, and whitespace
+        # between optional groups, so require at least one group.
+        if not parts:
+            return None
+
+        return timedelta(**parts)
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        try:
+            if isinstance(value, int) and not isinstance(value, bool):
+                converted = timedelta(seconds=value) if value >= 0 else None
+            elif isinstance(value, str):
+                converted = self._parse(value)
+            else:
+                converted = None
+        except OverflowError:
+            converted = None
+
+        if converted is None:
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+        return converted
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
