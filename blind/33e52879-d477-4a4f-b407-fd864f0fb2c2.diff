+
+from typing_extensions import assert_type
+
+import click
+
+assert_type(click.Duration().convert("1h30m", None, None), datetime.timedelta)
+assert_type(click.Duration()("90s"), datetime.timedelta)
+assert_type(click.prompt("Timeout", type=click.Duration()), datetime.timedelta)
