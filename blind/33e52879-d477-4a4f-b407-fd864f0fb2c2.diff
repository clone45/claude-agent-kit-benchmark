diff --git a/tests/test_types/test_Duration.py b/tests/test_types/test_Duration.py
new file mode 100644
index 0000000..46bff8b
--- /dev/null
+++ b/tests/test_types/test_Duration.py
@@ -0,0 +1,106 @@
+import datetime
+
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", datetime.timedelta(seconds=90)),
+        ("5m", datetime.timedelta(minutes=5)),
+        ("1h30m", datetime.timedelta(minutes=90)),
+        ("1h 30m", datetime.timedelta(minutes=90)),
+        ("2d", datetime.timedelta(days=2)),
+        (
+            "1D2H3M4S",
+            datetime.timedelta(days=1, hours=2, minutes=3, seconds=4),
+        ),
+        ("1d 2h 3m 4s", datetime.timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1d4s", datetime.timedelta(days=1, seconds=4)),
+        ("  1h  ", datetime.timedelta(hours=1)),
+        ("45", datetime.timedelta(seconds=45)),
+        (" 45 ", datetime.timedelta(seconds=45)),
+        ("0s", datetime.timedelta(0)),
+        ("0", datetime.timedelta(0)),
+        (45, datetime.timedelta(seconds=45)),
+        (0, datetime.timedelta(0)),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_timedelta_unchanged():
+    value = datetime.timedelta(hours=3)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "   ",
+        "5x",
+        "1.5h",
+        "-5s",
+        "-5",
+        "+5s",
+        "30m1h",
+        "1h1h",
+        "h",
+        "abc",
+        "1h30",
+        "5 m",
+        "٣s",
+        "99999999999d",
+        -5,
+        True,
+        1.5,
+        b"5s",
+        ["5s"],
+    ],
+)
+def test_convert_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert repr(value) in exc_info.value.message
+
+
+def test_name_and_repr():
+    assert click.Duration().name == "duration"
+    assert repr(click.Duration()) == "DURATION"
+
+
+def test_option(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        click.echo(repr(timeout))
+
+    result = runner.invoke(cli, ["--timeout", "1h30m"])
+    assert result.exit_code == 0, result.output
+    assert result.output == f"{datetime.timedelta(minutes=90)!r}\n"
+
+    result = runner.invoke(cli, ["--timeout", "30m1h"])
+    assert result.exit_code == 2
+    assert (
+        "Invalid value for '--timeout': '30m1h' is not a valid duration."
+        in result.output
+    )
+
+    result = runner.invoke(cli, ["--help"])
+    assert "--timeout DURATION" in result.output
+
+
+def test_option_default(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default="5m")
+    def cli(timeout):
+        click.echo(timeout.total_seconds())
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0, result.output
+    assert result.output == "300.0\n"
