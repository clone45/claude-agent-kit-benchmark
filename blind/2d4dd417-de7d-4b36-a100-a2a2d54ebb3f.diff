diff --git a/tests/typing/typing_path.py b/tests/typing/typing_path.py
new file mode 100644
index 0000000..1b7a83e
--- /dev/null
+++ b/tests/typing/typing_path.py
@@ -0,0 +1,49 @@
+import os
+import pathlib
+
+from typing_extensions import assert_type
+
+import click
+
+# ``path_type`` narrows the converted value type.
+assert_type(
+    click.Path(path_type=pathlib.Path).convert("a/b.txt", None, None), pathlib.Path
+)
+assert_type(click.Path(path_type=str).convert("a/b.txt", None, None), str)
+assert_type(click.Path(path_type=bytes).convert("a/b.txt", None, None), bytes)
+assert_type(
+    click.Path(path_type=pathlib.Path).coerce_path_result("a/b.txt"), pathlib.Path
+)
+
+# Without ``path_type``, the value type is unchanged from before.
+assert_type(click.Path().convert("a/b.txt", None, None), str | bytes | os.PathLike[str])
+assert_type(
+    click.Path(exists=True).coerce_path_result("a/b.txt"),
+    str | bytes | os.PathLike[str],
+)
+
+# The narrowed type is also inferred when ``path_type`` is passed positionally.
+assert_type(
+    click.Path(False, True, True, False, True, False, False, pathlib.Path),
+    click.Path[pathlib.Path],
+)
+
+# ``Path`` can be parameterized explicitly.
+explicit: click.Path[pathlib.Path] = click.Path(path_type=pathlib.Path)
+assert_type(explicit.convert("a/b.txt", None, None), pathlib.Path)
+
+# Instances are assignable to the matching ``ParamType``.
+as_param_type: click.ParamType[pathlib.Path] = click.Path(path_type=pathlib.Path)
+default_param_type: click.ParamType[str | bytes | os.PathLike[str]] = click.Path()
+
+# Calling the instance accepts path-like input and passes ``None`` through.
+assert_type(
+    click.Path(path_type=pathlib.Path)(pathlib.PurePosixPath("a/b.txt")),
+    pathlib.Path,
+)
+assert_type(click.Path(path_type=str)(pathlib.PurePosixPath("a/b.txt")), str)
+assert_type(click.Path(path_type=pathlib.Path)(None), None)
+
+# ``click.prompt`` carries the narrowed type.
+assert_type(click.prompt("File", type=click.Path(path_type=pathlib.Path)), pathlib.Path)
+assert_type(click.prompt("File", type=click.Path()), str | bytes | os.PathLike[str])
