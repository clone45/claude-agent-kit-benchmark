+def _color_code(color: int | tuple[int, int, int] | str | None, offset: int = 0) -> str:
+    """Returns the ANSI escape sequence for a color, or an empty string if
+    the color is ``None``. ``offset`` is ``10`` for background colors.
+    """
+    if color is None:
+        return ""
+
+    return f"\033[{_interpret_color(color, offset)}m"
+
+
+def _attribute_code(enabled: bool | None, on: int, off: int) -> str:
+    """Returns the ANSI escape sequence that enables (``on``) or disables
+    (``off``) a text attribute, or an empty string if ``enabled`` is ``None``.
+    """
+    if enabled is None:
+        return ""
+
+    return f"\033[{on if enabled else off}m"
+
