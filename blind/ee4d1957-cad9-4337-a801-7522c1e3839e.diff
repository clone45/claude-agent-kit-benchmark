+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_pathlike(tmp_path):
+    single = tmp_path / "single.txt"
+    single.write_text("a\nb\n")
+
+    result = click.edit(filename=single, editor="sed -i~ 's/$/Test/'")
+    assert result is None
+    assert single.read_text() == "aTest\nbTest\n"
+
+    as_str = tmp_path / "as_str.txt"
+    as_path = tmp_path / "as_path.txt"
+    as_str.write_text("c\n")
+    as_path.write_text("d\n")
+
+    result = click.edit(filename=[str(as_str), as_path], editor="sed -i~ 's/$/Test/'")
+    assert result is None
+    assert as_str.read_text() == "cTest\n"
+    assert as_path.read_text() == "dTest\n"
+
+
