+@pytest.mark.parametrize(
+    ("help_names", "params", "expected"),
+    [
+        (["-h", "--help"], [], ["-h", "--help"]),
+        (["--help", "-h", "-?"], [], ["--help", "-h", "-?"]),
+        (["-h", "--help", "-h"], [], ["-h", "--help"]),
+        (["-h", "--help"], [click.Option(["--help"])], ["-h"]),
+        (
+            ["--no-shout", "--help"],
+            [click.Option(["--shout/--no-shout"])],
+            ["--help"],
+        ),
+        (["--shout", "--help"], [click.Option(["--shout/--no-shout"])], ["--help"]),
+        (
+            ["-h", "--help"],
+            [click.Option(["-h"]), click.Option(["--help"])],
+            [],
+        ),
+    ],
+    ids=[
+        "default",
+        "declared-order",
+        "duplicates",
+        "taken-by-option",
+        "taken-by-secondary-opt",
+        "taken-by-primary-opt",
+        "all-taken",
+    ],
+)
+def test_get_help_option_names(help_names, params, expected):
+    """Help option names keep their declared order, drop duplicates, and
+    skip names already used by another parameter.
+    """
+    cli = click.Command("cli", params=params)
+    ctx = click.Context(cli, help_option_names=help_names)
+    assert cli.get_help_option_names(ctx) == expected
+
+
+def test_get_help_option_names_all_taken_disables_help(runner):
+    """When every help name is taken, no help option is added."""
+    cli = click.Command(
+        "cli",
+        context_settings={"help_option_names": ["--help"]},
+        params=[click.Option(["--help"], is_flag=True)],
+        callback=lambda help: click.echo(f"help={help}"),
+    )
+    ctx = click.Context(cli, help_option_names=["--help"])
+    assert cli.get_help_option(ctx) is None
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.output == "help=True\n"
+    assert result.exit_code == 0
+
+
+def test_help_option_uses_declared_name_order():
+    """The generated help option receives its names in declared order."""
+    cli = click.Command("cli")
+    ctx = click.Context(cli, help_option_names=["--help", "-h", "-?", "-h"])
+    help_option = cli.get_help_option(ctx)
+    assert help_option is not None
+    assert help_option.opts == ["--help", "-h", "-?"]
+
+
