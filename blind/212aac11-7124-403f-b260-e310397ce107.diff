+@pytest.mark.skipif(WIN, reason="No sed on Windows.")
+def test_edit_pathlike(runner, tmp_path):
+    """``filename`` accepts a single ``os.PathLike`` value."""
+    file_path = tmp_path / "file.txt"
+    file_path.write_text("a\nb\n", encoding="utf-8")
+
+    result = click.edit(filename=file_path, editor="sed -i~ 's/$/Test/'")
+    assert result is None
+    assert file_path.read_text(encoding="utf-8") == "aTest\nbTest\n"
+
+
+@pytest.mark.skipif(WIN, reason="No sed on Windows.")
+def test_edit_mixed_str_and_pathlike(runner, tmp_path):
+    """``filename`` accepts an iterable mixing ``str`` and ``os.PathLike``."""
+    str_path = tmp_path / "a.txt"
+    path_path = tmp_path / "b.txt"
+    str_path.write_text("a\n", encoding="utf-8")
+    path_path.write_text("b\n", encoding="utf-8")
+
+    result = click.edit(
+        filename=[str(str_path), path_path], editor="sed -i~ 's/$/Test/'"
+    )
+    assert result is None
+    assert str_path.read_text(encoding="utf-8") == "aTest\n"
+    assert path_path.read_text(encoding="utf-8") == "bTest\n"
+
+
