@@ -146,6 +146,24 @@ def _format_deprecated_suffix(deprecated: bool | str) -> str:
     return ""
 
 
+def _is_bracketed(metavar: str) -> bool:
+    """Return whether ``metavar`` is enclosed in a single pair of square
+    brackets, like ``[a|b]``. ``[a]|[b]`` starts and ends with brackets but
+    is not enclosed by one pair.
+    """
+    if not (metavar.startswith("[") and metavar.endswith("]")):
+        return False
+    depth = 0
+    for i, char in enumerate(metavar):
+        if char == "[":
+            depth += 1
+        elif char == "]":
+            depth -= 1
+            if depth == 0:
+                return i == len(metavar) - 1
+    return False
+
