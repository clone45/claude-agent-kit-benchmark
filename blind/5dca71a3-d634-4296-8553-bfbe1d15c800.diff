+@pytest.mark.parametrize(
+    ("type", "kwargs", "expected"),
+    [
+        (click.Choice(["foo", "bar", "baz"]), {}, "{foo|bar|baz}"),
+        (click.Choice(["foo", "bar", "baz"]), {"required": False}, "[foo|bar|baz]"),
+        (click.Choice(["foo", "bar", "baz"]), {"nargs": -1}, "[foo|bar|baz]..."),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"nargs": -1, "required": True},
+            "{foo|bar|baz}...",
+        ),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"nargs": 2, "required": False},
+            "[foo|bar|baz]...",
+        ),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"required": False, "deprecated": True},
+            "[foo|bar|baz]!",
+        ),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"nargs": -1, "deprecated": True},
+            "[foo|bar|baz]!...",
+        ),
+        (click.DateTime(formats=["%Y-%m-%d"]), {}, "[%Y-%m-%d]"),
+        (click.DateTime(formats=["%Y-%m-%d"]), {"required": False}, "[%Y-%m-%d]"),
+        (
+            click.DateTime(formats=["%Y-%m-%d"]),
+            {"nargs": -1},
+            "[%Y-%m-%d]...",
+        ),
+        (
+            click.Choice(["foo", "bar"]),
+            {"required": False, "metavar": "MODE"},
+            "MODE",
+        ),
+    ],
+)
+def test_argument_type_brackets_mark_optional(runner, type, kwargs, expected):
+    """A type that already brackets its metavar is not bracketed again in
+    the usage line when the argument is optional.
+    """
+
+    @click.command()
+    @click.argument("x", type=type, **kwargs)
+    def cli(x):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
+
+
+@pytest.mark.parametrize(
+    ("metavar", "expected"),
+    [("[a]|[b]", "[[a]|[b]]"), ("[a]", "[a]"), ("[[a]]", "[[a]]")],
+)
+def test_argument_type_metavar_partial_brackets(runner, metavar, expected):
+    """Only a metavar enclosed by one outer pair of brackets counts as
+    already bracketed.
+    """
+
+    class Custom(click.ParamType):
+        name = "custom"
+
+        def get_metavar(self, param, ctx):
+            return metavar
+
+    @click.command()
+    @click.argument("x", type=Custom(), required=False)
+    def cli(x):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
+
+
 @pytest.mark.parametrize(
