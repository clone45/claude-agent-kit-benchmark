 def batch(iterable: cabc.Iterable[V], batch_size: int) -> list[tuple[V, ...]]:
     return list(zip(*repeat(iter(iterable), batch_size), strict=False))
 
@@ -3977,6 +3995,17 @@ class Argument(Parameter):
         return name, [arg], []
 
     def get_usage_pieces(self, ctx: Context) -> list[str]:
+        # A type such as Choice or DateTime may already wrap its metavar in
+        # brackets. For an optional argument those brackets double as the
+        # optional marker, rather than being wrapped a second time.
+        if self.metavar is None and not self.required:
+            var = self.type.get_metavar(param=self, ctx=ctx)
+            if var and _is_bracketed(var):
+                if self.deprecated:
+                    var += "!"
+                if self.nargs != 1:
+                    var += "..."
+                return [var]
         return [self.make_metavar(ctx)]
 
