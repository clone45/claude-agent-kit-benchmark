+def _toggle_code(value: bool | None, on: int, off: int) -> str:
+    """Returns the ANSI code that turns an attribute on or off, or an empty
+    string if ``value`` is ``None`` and the attribute is left unchanged.
+    """
+    if value is None:
+        return ""
+
+    return f"\033[{on if value else off}m"
+
