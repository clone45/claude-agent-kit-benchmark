     assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
 
 
+@pytest.mark.parametrize(
+    ("type", "kwargs", "expected"),
+    [
+        (click.Choice(["foo", "bar", "baz"]), {"nargs": -1}, "[foo|bar|baz]..."),
+        (click.Choice(["foo", "bar", "baz"]), {"required": False}, "[foo|bar|baz]"),
+        (click.Choice(["foo", "bar", "baz"]), {"default": "foo"}, "[foo|bar|baz]"),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"nargs": 2, "required": False},
+            "[foo|bar|baz]...",
+        ),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"required": False, "deprecated": True},
+            "[foo|bar|baz]!",
+        ),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"nargs": -1, "deprecated": True},
+            "[foo|bar|baz]!...",
+        ),
+        (click.DateTime(formats=["%Y-%m-%d"]), {"required": False}, "[%Y-%m-%d]"),
+        (
+            click.DateTime(formats=["%Y-%m-%d", "%Y"]),
+            {"nargs": -1},
+            "[%Y-%m-%d|%Y]...",
+        ),
+        # Required arguments are unchanged.
+        (click.Choice(["foo", "bar", "baz"]), {}, "{foo|bar|baz}"),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"nargs": -1, "required": True},
+            "{foo|bar|baz}...",
+        ),
+        (click.DateTime(formats=["%Y-%m-%d"]), {}, "[%Y-%m-%d]"),
+        # An explicit metavar is used verbatim.
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"required": False, "metavar": "[MODE]"},
+            "[MODE]",
+        ),
+    ],
+)
+def test_argument_type_brackets_mark_optional(runner, type, kwargs, expected):
+    """A type that brackets its own metavar is not bracketed again in the
+    usage line when the argument is optional.
+    """
+
+    @click.command()
+    @click.argument("foo", type=type, **kwargs)
+    def cli(foo):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
+
+
+@pytest.mark.parametrize(
+    ("metavar", "expected"),
+    [("[a]|[b]", "[[a]|[b]]"), ("[a", "[[a]"), ("a]", "[a]]")],
+)
+def test_argument_partially_bracketed_type_metavar(runner, metavar, expected):
+    """A type metavar that is not one enclosing bracket pair is still
+    wrapped in the optional marker.
+    """
+
+    class Custom(click.ParamType):
+        name = "custom"
+
+        def get_metavar(self, param, ctx):
+            return metavar
+
+    @click.command()
+    @click.argument("foo", type=Custom(), required=False)
+    def cli(foo):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
+
+
 @pytest.mark.parametrize(
