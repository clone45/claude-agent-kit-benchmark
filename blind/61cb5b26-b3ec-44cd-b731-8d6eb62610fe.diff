--- a/src/click/core.py
+++ b/src/click/core.py
@@ -146,6 +146,24 @@ def _format_deprecated_suffix(deprecated: bool | str) -> str:
     return ""
 
 
+def _is_bracketed(metavar: str) -> bool:
+    """Return whether the whole metavar is enclosed in a single pair of
+    square brackets, like ``[foo|bar]``. ``[a]|[b]`` is not, because its
+    first bracket closes before the end.
+    """
+    if not (metavar.startswith("[") and metavar.endswith("]")):
+        return False
+    depth = 0
+    for i, char in enumerate(metavar):
+        if char == "[":
+            depth += 1
+        elif char == "]":
+            depth -= 1
+            if depth == 0:
+                return i == len(metavar) - 1
+    return False
+
+
 def batch(iterable: cabc.Iterable[V], batch_size: int) -> list[tuple[V, ...]]:
     return list(zip(*repeat(iter(iterable), batch_size), strict=False))
 
@@ -3977,6 +3995,16 @@ class Argument(Parameter):
         return name, [arg], []
 
     def get_usage_pieces(self, ctx: Context) -> list[str]:
+        if self.metavar is None and not self.required:
+            var = self.type.get_metavar(param=self, ctx=ctx)
+            # A type like Choice or DateTime already brackets its metavar, and
+            # those brackets double as the optional marker in the synopsis.
+            if var and _is_bracketed(var):
+                if self.deprecated:
+                    var += "!"
+                if self.nargs != 1:
+                    var += "..."
+                return [var]
         return [self.make_metavar(ctx)]
 
