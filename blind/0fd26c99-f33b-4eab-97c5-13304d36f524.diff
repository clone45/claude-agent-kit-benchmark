diff --git a/tests/test_commands.py b/tests/test_commands.py
index c2de826..fe81577 100644
--- a/tests/test_commands.py
+++ b/tests/test_commands.py
@@ -698,3 +698,115 @@ def test_suggest_possible_commands(runner, value, expect):
 
     result = runner.invoke(cli, [value])
     assert expect in result.output
+
+
+def test_help_option_reserved_storage_name():
+    """The automatic help option stores its value under a reserved name."""
+    cli = click.Command("cli")
+    ctx = click.Context(cli)
+    help_option = cli.get_help_option(ctx)
+    assert help_option is not None
+    assert help_option.name == "_click_default_help"
+    assert help_option.to_info_dict()["name"] == "_click_default_help"
+
+
+def test_argument_named_help(runner):
+    """An argument named ``help`` does not collide with the help option."""
+    seen = {}
+
+    def callback(**kwargs):
+        seen.update(kwargs)
+
+    cli = click.Command("cli", params=[click.Argument(["help"])], callback=callback)
+    result = runner.invoke(cli, ["value"])
+    assert result.exit_code == 0, result.output
+    assert seen == {"help": "value"}
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert "Show this message and exit." in result.output
+
+
+def test_option_named_help(runner):
+    """An option with the explicit name ``help`` receives its value."""
+    seen = {}
+
+    def callback(**kwargs):
+        seen.update(kwargs)
+
+    cli = click.Command(
+        "cli", params=[click.Option(["--assist", "help"])], callback=callback
+    )
+    result = runner.invoke(cli, ["--assist", "value"])
+    assert result.exit_code == 0, result.output
+    assert seen == {"help": "value"}
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert "Show this message and exit." in result.output
+
+
+@pytest.mark.parametrize("help_option_names", [["--man"], ["/?"]])
+def test_custom_help_option_names_with_help_parameter(runner, help_option_names):
+    """Custom help option names, even ones that are not identifiers, print
+    the help without warning.
+    """
+    cli = click.Command(
+        "cli",
+        params=[click.Option(["--assist", "help"])],
+        context_settings={"help_option_names": help_option_names},
+    )
+    result = runner.invoke(cli, help_option_names)
+    assert result.exit_code == 0
+    assert "Show this message and exit." in result.output
+    assert cli.get_help_option(click.Context(cli)).name == "_click_default_help"
+
+
+def test_argument_storage_name_collision_warns():
+    cli = click.Command(
+        "cli", params=[click.Argument(["name"]), click.Option(["--name"])]
+    )
+
+    with pytest.warns(UserWarning, match="'name' is used by an argument"):
+        cli.get_params(click.Context(cli))
+
+
+def test_reserved_help_storage_name_warns():
+    cli = click.Command("cli", params=[click.Option(["--x", "_click_default_help"])])
+
+    with pytest.warns(UserWarning, match="reserved for the automatic help option"):
+        cli.get_params(click.Context(cli))
+
+
+def test_feature_switch_shared_storage_name_does_not_warn(runner):
+    """Options that share a storage name on purpose do not warn."""
+
+    @click.command()
+    @click.option("--upper", "transformation", flag_value="upper")
+    @click.option("--lower", "transformation", flag_value="lower")
+    def cli(transformation):
+        click.echo(transformation)
+
+    result = runner.invoke(cli, ["--upper"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "upper\n"
+
+
+def test_help_flag_reused_by_option(runner):
+    """An option declaring ``--help`` replaces the automatic help option."""
+
+    @click.command()
+    @click.option("--help", default="default value")
+    def cli(help):
+        click.echo(help)
+
+    assert cli.get_help_option(click.Context(cli)) is None
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0, result.output
+    assert result.output == "default value\n"
+
+    result = runner.invoke(cli, ["--help", "given"])
+    assert result.exit_code == 0, result.output
+    assert result.output == "given\n"
+    assert "Show this message and exit." not in result.output
