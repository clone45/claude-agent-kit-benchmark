+def _detect_caller_package_name() -> str | None:
+    """Detect the top-level package name of the module that called
+    :func:`version_option`, by inspecting the stack frames. Must be called
+    directly from :func:`version_option`.
+    """
+    frame = inspect.currentframe()
+    # Skip this function's frame and version_option's frame.
+    version_option_frame = frame.f_back if frame is not None else None
+    caller = version_option_frame.f_back if version_option_frame is not None else None
+    f_globals = caller.f_globals if caller is not None else None
+    # break reference cycle
+    # https://docs.python.org/3/library/inspect.html#the-interpreter-stack
+    del frame
+
+    if f_globals is None:
+        return None
+
+    package_name: str | None = f_globals.get("__name__")
+
+    if package_name == "__main__":
+        package_name = f_globals.get("__package__")
+
+    if package_name:
+        package_name = package_name.partition(".")[0]
+
+    return package_name
+
+
+def _lookup_distribution_version(package_name: str) -> tuple[str, str | None]:
+    """Look up the installed version for ``package_name`` with
+    :mod:`importlib.metadata`. If the name doesn't match an installed
+    distribution, resolve it as an import (top-level module) name.
+
+    Returns the distribution name the version was found under, and the
+    version.
+
+    :raise RuntimeError: The import name maps to zero or to multiple
+        installed distributions.
+    """
+    import importlib.metadata
+
+    try:
+        return package_name, importlib.metadata.version(package_name)
+    except importlib.metadata.PackageNotFoundError:
+        # The given name didn't match an installed distribution.
+        # Try resolving it as an import (top-level module) name,
+        # e.g. ``PIL`` is provided by the ``Pillow`` distribution.
+        distributions = importlib.metadata.packages_distributions().get(
+            package_name, []
+        )
+        if len(distributions) == 1:
+            return distributions[0], importlib.metadata.version(distributions[0])
+        elif len(distributions) > 1:
+            raise RuntimeError(
+                f"{package_name!r} maps to multiple installed"
+                f" distributions ({', '.join(distributions)})."
+                " Pass 'package_name' to disambiguate."
+            ) from None
+        else:
+            raise RuntimeError(
+                f"{package_name!r} is not installed. Try passing"
+                " 'package_name' instead."
+            ) from None
+
+
+def _detect_package_version(package_name: str | None) -> tuple[str | None, str]:
+    """Detect the version for :func:`version_option` when it was not given.
+
+    Returns the package name to show (the resolved distribution name if
+    the given name was an import name), and the version.
+
+    :raise RuntimeError: The version could not be determined.
+    """
+    version: str | None = None
+
+    if package_name is not None:
+        package_name, version = _lookup_distribution_version(package_name)
+
+    if version is None:
+        raise RuntimeError(
+            f"Could not determine the version for {package_name!r} automatically."
+        )
+
+    return package_name, version
+
+
