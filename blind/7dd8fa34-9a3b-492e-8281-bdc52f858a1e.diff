     raise ValueError(_("Unknown color {colour!r}").format(colour=color))
 
 
+def _color_sequence(
+    color: int | tuple[int, int, int] | str | None, offset: int = 0
+) -> str:
+    """Returns the escape sequence that sets a color, or an empty string
+    if ``color`` is ``None``. Pass ``offset=10`` for a background color.
+    """
+    if color is None:
+        return ""
+
+    return f"\033[{_interpret_color(color, offset)}m"
+
+
+def _attribute_sequence(value: bool | None, on: int, off: int) -> str:
+    """Returns the escape sequence that enables (``on``) or disables
+    (``off``) a text attribute, or an empty string if ``value`` is ``None``.
+    """
+    if value is None:
+        return ""
+
+    return f"\033[{on if value else off}m"
+
