+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_pathlike(tmp_path):
+    path = tmp_path / "file.txt"
+    path.write_text("a\nb\n")
+
+    result = click.edit(filename=path, editor="sed -i~ 's/$/Test/'")
+    assert result is None
+    assert path.read_text() == "aTest\nbTest\n"
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_mixed_str_and_pathlike(tmp_path):
+    str_path = tmp_path / "a.txt"
+    pathlike = tmp_path / "b.txt"
+    str_path.write_text("a\n")
+    pathlike.write_text("b\n")
+
+    result = click.edit(
+        filename=[str(str_path), pathlike], editor="sed -i~ 's/$/Test/'"
+    )
+    assert result is None
+    assert str_path.read_text() == "aTest\n"
+    assert pathlike.read_text() == "bTest\n"
+
+
