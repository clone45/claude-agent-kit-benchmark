+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+@pytest.mark.parametrize("use_iterable", [False, True], ids=["single", "iterable"])
+def test_edit_pathlike(tmp_path, use_iterable):
+    """``filename`` accepts ``os.PathLike`` values, alone or mixed with
+    strings in an iterable.
+    """
+    path_file = tmp_path / "path.txt"
+    path_file.write_text("a\nb\n", encoding="utf-8")
+    str_file = tmp_path / "str.txt"
+    str_file.write_text("c\n", encoding="utf-8")
+    filename = [str(str_file), path_file] if use_iterable else path_file
+
+    result = click.edit(filename=filename, editor="sed -i~ 's/$/Test/'")
+    assert result is None
+    assert path_file.read_text(encoding="utf-8") == "aTest\nbTest\n"
+    expected = "cTest\n" if use_iterable else "c\n"
+    assert str_file.read_text(encoding="utf-8") == expected
+
