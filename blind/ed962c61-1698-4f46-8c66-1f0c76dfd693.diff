+    "make_filename",
+    [
+        pytest.param(lambda paths: paths[0], id="single"),
+        pytest.param(lambda paths: paths, id="iterable"),
+        pytest.param(lambda paths: [str(paths[0]), paths[1]], id="mixed"),
+    ],
+)
+def test_edit_pathlike(runner, tmp_path, make_filename):
+    """``filename`` accepts ``os.PathLike`` values, alone or in an iterable."""
+    paths = [tmp_path / "a.txt", tmp_path / "b.txt"]
+
+    for path in paths:
+        path.write_text("a\nb\n", encoding="UTF-8")
+
+    filename = make_filename(paths)
+    expected = {paths[0]} if isinstance(filename, pathlib.Path) else set(paths)
+    result = click.edit(filename=filename, editor="sed -i~ 's/$/Test/'")
+    assert result is None
+
+    for path in paths:
+        content = "aTest\nbTest\n" if path in expected else "a\nb\n"
+        assert path.read_text(encoding="UTF-8") == content
+
