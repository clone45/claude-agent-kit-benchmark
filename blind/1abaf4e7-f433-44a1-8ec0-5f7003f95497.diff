+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+@pytest.mark.parametrize("as_iterable", [False, True], ids=["single", "iterable"])
+def test_edit_pathlike(runner, tmp_path, as_iterable):
+    """``filename`` accepts ``os.PathLike`` values, alone or in an iterable
+    mixed with strings."""
+    path_file = tmp_path / "path.txt"
+    path_file.write_text("a\nb\n", encoding="UTF-8")
+    str_file = tmp_path / "str.txt"
+    str_file.write_text("c\n", encoding="UTF-8")
+    filename = [str(str_file), path_file] if as_iterable else path_file
+
+    result = click.edit(filename=filename, editor="sed -i~ 's/$/Test/'")
+    assert result is None
+    assert path_file.read_text(encoding="UTF-8") == "aTest\nbTest\n"
+
+    if as_iterable:
+        assert str_file.read_text(encoding="UTF-8") == "cTest\n"
+
+
+def test_editor_edit_files_pathlike_args():
+    """``Editor.edit_files`` passes path-like values to the editor as strings."""
+    with patch("subprocess.Popen") as mock_popen:
+        mock_popen.return_value.wait.return_value = 0
+        Editor(editor="vi").edit_files(["a.txt", pathlib.Path("b.txt")])
+
+        args = mock_popen.call_args[1].get("args") or mock_popen.call_args[0][0]
+        assert args == ["vi", "a.txt", os.fspath(pathlib.Path("b.txt"))]
+
+
