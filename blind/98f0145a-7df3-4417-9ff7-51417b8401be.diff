diff --git a/tests/test_arguments.py b/tests/test_arguments.py
index 5921905..2733536 100644
--- a/tests/test_arguments.py
+++ b/tests/test_arguments.py
@@ -832,6 +832,42 @@ def test_argument_metavar_marks_optional(runner, kwargs, expected):
     assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
 
 
+_CHOICE = click.Choice(["foo", "bar", "baz"])
+_DATETIME = click.DateTime(formats=["%Y-%m-%d"])
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "expected"),
+    [
+        ({"type": _CHOICE, "nargs": -1}, "[foo|bar|baz]..."),
+        ({"type": _CHOICE, "required": False}, "[foo|bar|baz]"),
+        ({"type": _CHOICE, "default": "foo"}, "[foo|bar|baz]"),
+        ({"type": _CHOICE, "nargs": 2, "required": False}, "[foo|bar|baz]..."),
+        ({"type": _CHOICE, "required": False, "deprecated": True}, "[foo|bar|baz]!"),
+        ({"type": _CHOICE}, "{foo|bar|baz}"),
+        ({"type": _CHOICE, "nargs": -1, "required": True}, "{foo|bar|baz}..."),
+        ({"type": _DATETIME, "required": False}, "[%Y-%m-%d]"),
+        ({"type": _DATETIME, "nargs": -1}, "[%Y-%m-%d]..."),
+        ({"type": _DATETIME}, "[%Y-%m-%d]"),
+        ({"type": _CHOICE, "required": False, "metavar": "MODE"}, "MODE"),
+        ({"type": int, "required": False}, "[FOO]"),
+    ],
+)
+def test_argument_usage_reuses_type_brackets(runner, kwargs, expected):
+    """A type whose metavar is already bracketed is not bracketed again in
+    the usage line when the argument is optional.
+    """
+
+    @click.command()
+    @click.argument("foo", **kwargs)
+    def cli(foo):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
+
+
 @pytest.mark.parametrize(
     ("deprecated", "expected_label"),
     [(True, "(DEPRECATED)"), ("use g instead", "(DEPRECATED: use g instead)")],
