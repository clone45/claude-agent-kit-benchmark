+@pytest.mark.parametrize(
+    "help_option_names", [["--help"], ["--man"], ["-h", "--help"], ["/?"]]
+)
+def test_help_option_storage_name(runner, help_option_names):
+    """The automatic help option stores its value under a reserved name, whatever
+    flags spell it, and still prints the help page.
+    """
+    cli = click.Command(
+        "cli", context_settings={"help_option_names": help_option_names}
+    )
+    ctx = click.Context(cli, help_option_names=help_option_names)
+    assert cli.get_help_option(ctx).name == "_click_default_help"
+
+    result = runner.invoke(cli, [help_option_names[-1]])
+    assert "Show this message and exit." in result.stdout
+    assert result.exit_code == 0
+
+
+def test_argument_named_help(runner):
+    """An argument named ``help`` does not collide with the help option."""
+    cli = click.Command(
+        "cli",
+        params=[click.Argument(["help"])],
+        callback=lambda help: click.echo(f"help={help}"),
+    )
+
+    result = runner.invoke(cli, ["value"])
+    assert result.exception is None
+    assert result.stdout == "help=value\n"
+
+    result = runner.invoke(cli, ["--help"])
+    assert "Show this message and exit." in result.stdout
+    assert result.exit_code == 0
+
+
+@pytest.mark.parametrize("help_option_names", [["--help"], ["--man"]])
+def test_option_named_help(runner, help_option_names):
+    """An option whose storage name is ``help`` does not collide with the help
+    option.
+    """
+    cli = click.Command(
+        "cli",
+        params=[click.Option(["--assist", "help"])],
+        callback=lambda help: click.echo(f"help={help}"),
+        context_settings={"help_option_names": help_option_names},
+    )
+
+    result = runner.invoke(cli, ["--assist", "value"])
+    assert result.exception is None
+    assert result.stdout == "help=value\n"
+
+    result = runner.invoke(cli, help_option_names)
+    assert "Show this message and exit." in result.stdout
+    assert result.exit_code == 0
+
+
+def test_option_reusing_help_flag(runner):
+    """An option declaring ``--help`` replaces the automatic help option."""
+
+    @click.command()
+    @click.option("--help", default="default value")
+    def cli(help):
+        click.echo(f"help={help}")
+
+    ctx = click.Context(cli)
+    assert cli.get_help_option(ctx) is None
+
+    result = runner.invoke(cli, [])
+    assert result.exception is None
+    assert result.stdout == "help=default value\n"
+
+    result = runner.invoke(cli, ["--help", "given"])
+    assert result.exception is None
+    assert result.stdout == "help=given\n"
+    assert "Show this message and exit." not in result.stdout
+
+
+@pytest.mark.parametrize(
+    "params",
+    [
+        [click.Argument(["name"]), click.Option(["--name"])],
+        [click.Option(["--name"]), click.Argument(["name"])],
+        [click.Argument(["name"]), click.Option(["--other", "name"])],
+    ],
+    ids=["argument-option", "option-argument", "argument-explicit-name"],
+)
+def test_argument_storage_name_collision_warns(params):
+    cli = click.Command("cli", params=params)
+    ctx = click.Context(cli)
+
+    with pytest.warns(UserWarning, match="'name' is used by an argument") as record:
+        cli.get_params(ctx)
+
+    assert "overwrite each other's value during parsing" in str(record[0].message)
+
+
+@pytest.mark.parametrize(
+    "param",
+    [
+        click.Argument(["_click_default_help"]),
+        click.Option(["--other", "_click_default_help"]),
+    ],
+    ids=["argument", "option"],
+)
+@pytest.mark.parametrize("add_help_option", [True, False])
+def test_reserved_help_storage_name_warns(param, add_help_option):
+    cli = click.Command("cli", params=[param], add_help_option=add_help_option)
+    ctx = click.Context(cli)
+
+    # An argument also collides with the help option itself when it is added.
+    with pytest.warns(UserWarning) as record:
+        cli.get_params(ctx)
+
+    messages = [str(w.message) for w in record]
+    assert any("reserved for the automatic help option" in m for m in messages)
+
+
+def test_feature_switches_sharing_storage_name_do_not_warn(runner):
+    """Options deliberately sharing a storage name are not a collision."""
+
+    @click.command()
+    @click.option("--upper", "transformation", flag_value="upper")
+    @click.option("--lower", "transformation", flag_value="lower", default=True)
+    def cli(transformation):
+        click.echo(transformation)
+
+    result = runner.invoke(cli, ["--upper"])
+    assert result.exception is None
+    assert result.stdout == "upper\n"
+
+
 def test_unprocessed_options(runner):
     @click.command(context_settings=dict(ignore_unknown_options=True))
     @click.argument("args", nargs=-1, type=click.UNPROCESSED)
