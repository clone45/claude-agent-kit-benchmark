 import os
 import pathlib
 import platform
+import subprocess
+import sys
 import tempfile
 import typing as t
 
@@ -163,3 +165,23 @@ def test_path_type(runner, cls, expect):
 
 def test_path_converted_type_parameter_at_runtime():
     assert t.get_args(click.Path[pathlib.Path]) == (pathlib.Path,)
+
+
+def test_allow_dash_no_bytes_warning():
+    """Detecting the dash must not compare bytes with str, which raises a
+    ``BytesWarning`` error under ``python -bb``.
+    """
+    code = """\
+import click
+
+path_type = click.Path(allow_dash=True)
+
+for value in ("-", "", b"-", b""):
+    path_type.convert(value, None, None)
+"""
+    result = subprocess.run(
+        [sys.executable, "-bb", "-W", "error::BytesWarning", "-c", code],
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 0, result.stderr
