+def _color_code(color: int | tuple[int, int, int] | str | None, offset: int = 0) -> str:
+    """Return the escape sequence selecting ``color``, or an empty string
+    if ``color`` is ``None``. ``offset`` is 0 for foreground and 10 for
+    background. Raises :exc:`ValueError` for an invalid color.
+    """
+    if color is None:
+        return ""
+
+    return f"\033[{_interpret_color(color, offset)}m"
+
+
+def _toggle_code(value: bool | None, on: int, off: int) -> str:
+    """Return the escape sequence enabling (``on``) or disabling (``off``)
+    a text attribute based on the truthiness of ``value``, or an empty
+    string if ``value`` is ``None``.
+    """
+    if value is None:
+        return ""
+
+    return f"\033[{on if value else off}m"
+
