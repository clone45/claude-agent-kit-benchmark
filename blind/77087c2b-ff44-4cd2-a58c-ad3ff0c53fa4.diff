+class Duration(ParamType[timedelta, timedelta | int | str]):
+    """The Duration type converts strings such as ``90s``, ``5m``,
+    ``1h30m``, or ``2d`` into :class:`datetime.timedelta` objects.
+
+    A string is one or more groups of a non-negative integer followed by
+    a unit: ``d`` for days, ``h`` for hours, ``m`` for minutes, and ``s``
+    for seconds. Units must appear in that order, each at most once.
+    Units are case-insensitive, and whitespace is allowed between groups.
+    A bare integer without a unit, as a string or an ``int``, is a number
+    of seconds. A ``timedelta`` is returned unchanged.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _pattern = re.compile(
+        r"(?:(?P<days>\d+)d)?\s*"
+        r"(?:(?P<hours>\d+)h)?\s*"
+        r"(?:(?P<minutes>\d+)m)?\s*"
+        r"(?:(?P<seconds>\d+)s)?",
+        re.ASCII | re.IGNORECASE,
+    )
+
+    def convert(
+        self,
+        value: timedelta | int | str,
+        param: Parameter | None,
+        ctx: Context | None,
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        parts: dict[str, int] | None = None
+
+        if isinstance(value, int) and not isinstance(value, bool):
+            if value >= 0:
+                parts = {"seconds": value}
+        elif isinstance(value, str):
+            text = value.strip()
+
+            if text.isascii() and text.isdigit():
+                parts = {"seconds": int(text)}
+            elif (match := self._pattern.fullmatch(text)) is not None:
+                parts = {k: int(v) for k, v in match.groupdict().items() if v}
+
+        if parts:
+            try:
+                return timedelta(**parts)
+            except OverflowError:
+                pass
+
+        self.fail(
+            _("{value!r} is not a valid duration.").format(value=value), param, ctx
+        )
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
