diff --git a/tests/test_types/test_Duration.py b/tests/test_types/test_Duration.py
new file mode 100644
index 0000000..0500a71
--- /dev/null
+++ b/tests/test_types/test_Duration.py
@@ -0,0 +1,103 @@
+from datetime import timedelta
+
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("5m", timedelta(minutes=5)),
+        ("1h30m", timedelta(minutes=90)),
+        ("1h 30m", timedelta(minutes=90)),
+        ("2d", timedelta(days=2)),
+        ("1D2H3M4S", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1d 2h\t3m  4s", timedelta(days=1, hours=2, minutes=3, seconds=4)),
+        ("1d4s", timedelta(days=1, seconds=4)),
+        ("  1h  ", timedelta(hours=1)),
+        ("45", timedelta(seconds=45)),
+        (" 45 ", timedelta(seconds=45)),
+        ("0s", timedelta(0)),
+        ("0", timedelta(0)),
+        (45, timedelta(seconds=45)),
+        (0, timedelta(0)),
+        (timedelta(hours=3), timedelta(hours=3)),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_timedelta_returned_unchanged():
+    value = timedelta(minutes=1)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "   ",
+        "5x",
+        "1.5h",
+        "-5s",
+        "30m1h",
+        "1h1h",
+        "h",
+        "abc",
+        "1h30",
+        "1 h",
+        "５s",
+        "99999999999d",
+        -5,
+        True,
+        1.5,
+        None,
+        [],
+    ],
+)
+def test_convert_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert repr(value) in exc_info.value.message
+
+
+def test_repr_and_name():
+    assert repr(click.Duration()) == "DURATION"
+    assert click.Duration().name == "duration"
+
+
+@click.command()
+@click.option("--timeout", type=click.Duration())
+def timeout_cmd(timeout):
+    click.echo(repr(timeout))
+
+
+@pytest.mark.parametrize(
+    ("args", "expect"),
+    [
+        (["--timeout", "1h30m"], repr(timedelta(minutes=90))),
+        (["--timeout=45"], repr(timedelta(seconds=45))),
+        ([], "None"),
+    ],
+)
+def test_option(runner, args, expect):
+    result = runner.invoke(timeout_cmd, args)
+    assert result.exit_code == 0, result.output
+    assert result.output == f"{expect}\n"
+
+
+def test_option_invalid(runner):
+    result = runner.invoke(timeout_cmd, ["--timeout", "30m1h"])
+    assert result.exit_code == 2
+    assert "Invalid value for '--timeout'" in result.output
+    assert "'30m1h' is not a valid duration." in result.output
+
+
+def test_option_help_metavar(runner):
+    result = runner.invoke(timeout_cmd, ["--help"])
+    assert result.exit_code == 0
+    assert "--timeout DURATION" in result.output
