+def test_help_option_storage_name():
+    cli = click.Command("cli")
+    ctx = click.Context(cli)
+    assert cli.get_help_option(ctx).name == "_click_default_help"
+
+
+@pytest.mark.parametrize(
+    ("params", "args", "expect"),
+    [
+        ([click.Argument(["help"])], ["value"], {"help": "value"}),
+        ([click.Option(["--assist", "help"])], ["--assist", "x"], {"help": "x"}),
+        ([click.Option(["--assist", "help"])], [], {"help": None}),
+    ],
+)
+def test_param_named_help(runner, params, args, expect):
+    cli = click.Command("cli", params=params, callback=lambda **kw: kw)
+    result = runner.invoke(cli, args, standalone_mode=False)
+    assert result.exception is None
+    assert result.return_value == expect
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert "Show this message and exit." in result.output
+
+
+@pytest.mark.parametrize("help_names", [["--help"], ["--man"], ["/?"], ["-h", "/?"]])
+def test_help_option_names_print_help(runner, help_names):
+    cli = click.Command(
+        "cli",
+        params=[click.Argument(["help"], required=False)],
+        context_settings={"help_option_names": help_names},
+        callback=lambda help: help,
+    )
+    for name in help_names:
+        result = runner.invoke(cli, [name])
+        assert result.exit_code == 0
+        assert "Show this message and exit." in result.output
+
+    result = runner.invoke(cli, ["value"], standalone_mode=False)
+    assert result.return_value == "value"
+
+
+def test_help_option_reused_flag_replaces_help(runner):
+    @click.command()
+    @click.option("--help", default="default value")
+    def cli(help):
+        click.echo(f"help={help}")
+
+    ctx = click.Context(cli)
+    assert cli.get_help_option(ctx) is None
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0
+    assert result.output == "help=default value\n"
+
+    result = runner.invoke(cli, ["--help", "given"])
+    assert result.exit_code == 0
+    assert result.output == "help=given\n"
+    assert "Show this message and exit." not in result.output
+
+
+@pytest.mark.parametrize(
+    "params",
+    [
+        [click.Argument(["value"]), click.Option(["--value"])],
+        [click.Option(["--value"]), click.Argument(["value"])],
+        [click.Argument(["value"]), click.Argument(["VALUE"])],
+        [click.Argument(["help"]), click.Option(["--assist", "help"])],
+    ],
+)
+def test_argument_storage_name_collision_warns(params):
+    cli = click.Command("cli", params=params)
+    name = params[0].name
+
+    with pytest.warns(UserWarning, match=f"'{name}' is used by an argument") as rec:
+        cli.get_params(click.Context(cli))
+
+    assert "overwrite each other's value during parsing" in str(rec[0].message)
+
+
+@pytest.mark.parametrize(
+    "param",
+    [
+        click.Option(["--_click-default-help"]),
+        click.Option(["--other", "_click_default_help"]),
+    ],
+)
+def test_reserved_help_storage_name_warns(param):
+    cli = click.Command("cli", params=[param])
+
+    with pytest.warns(UserWarning, match="reserved for the automatic help option"):
+        cli.get_params(click.Context(cli))
+
+
+def test_reserved_help_storage_name_warns_without_help_option():
+    cli = click.Command(
+        "cli",
+        params=[click.Argument(["_click_default_help"])],
+        add_help_option=False,
+    )
+
+    with pytest.warns(UserWarning, match="reserved for the automatic help option"):
+        cli.get_params(click.Context(cli))
+
+
+def test_feature_switches_sharing_storage_name_do_not_warn(runner):
+    @click.command()
+    @click.option("--upper", "transformation", flag_value="upper")
+    @click.option("--lower", "transformation", flag_value="lower", default=True)
+    def cli(transformation):
+        click.echo(transformation)
+
+    # The test suite turns warnings into errors, so any warning fails here.
+    cli.get_params(click.Context(cli))
+    assert runner.invoke(cli, ["--upper"]).output == "upper\n"
+    assert runner.invoke(cli, []).output == "lower\n"
+
+
