+_DURATION_BARE_RE = re.compile(r"[0-9]+")
+_DURATION_RE = re.compile(
+    r"(?:([0-9]+)d)?\s*(?:([0-9]+)h)?\s*(?:([0-9]+)m)?\s*(?:([0-9]+)s)?",
+    re.IGNORECASE | re.ASCII,
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings and integers into `timedelta`
+    objects.
+
+    A string is a sequence of whole numbers, each immediately followed by a
+    unit: ``d`` (days), ``h`` (hours), ``m`` (minutes) or ``s`` (seconds).
+    Units are case-insensitive, must appear in that order, and may each be
+    used at most once. Whitespace is allowed around the value and between
+    groups. For example ``'90s'``, ``'1h30m'``, ``'1h 30m'`` and
+    ``'2d'``.
+
+    A string of digits without a unit is a number of seconds, so ``'45'``
+    is the same as ``'45s'``. An integer is also a number of seconds. A
+    `timedelta` is returned unchanged.
+
+    Negative values, decimals and booleans are rejected.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            return value
+
+        try:
+            if isinstance(value, int) and not isinstance(value, bool):
+                if value >= 0:
+                    return timedelta(seconds=value)
+            elif isinstance(value, str):
+                text = value.strip()
+
+                if _DURATION_BARE_RE.fullmatch(text):
+                    return timedelta(seconds=int(text))
+
+                match = _DURATION_RE.fullmatch(text)
+
+                if match and any(g is not None for g in match.groups()):
+                    d, h, m, s = (int(g or 0) for g in match.groups())
+                    return timedelta(days=d, hours=h, minutes=m, seconds=s)
+        except (OverflowError, ValueError):
+            pass
+
+        self.fail(
+            _(
+                "{value!r} is not a valid duration. Use a whole number of"
+                " days, hours, minutes, and seconds, such as '1h30m'."
+            ).format(value=value),
+            param,
+            ctx,
+        )
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
