--- a/src/click/core.py
+++ b/src/click/core.py
@@ -146,6 +146,27 @@ def _format_deprecated_suffix(deprecated: bool | str) -> str:
     return ""
 
 
+def _is_bracketed(metavar: str) -> bool:
+    """Return whether the whole metavar is a single ``[...]`` group, like the
+    ``[foo|bar]`` that :class:`~click.Choice` produces. ``[a]|[b]`` is not.
+    """
+    if not metavar.startswith("["):
+        return False
+
+    depth = 0
+
+    for i, char in enumerate(metavar):
+        if char == "[":
+            depth += 1
+        elif char == "]":
+            depth -= 1
+
+            if depth == 0:
+                return i == len(metavar) - 1
+
+    return False
+
+
 def batch(iterable: cabc.Iterable[V], batch_size: int) -> list[tuple[V, ...]]:
     return list(zip(*repeat(iter(iterable), batch_size), strict=False))
 
@@ -3977,6 +3998,19 @@ class Argument(Parameter):
         return name, [arg], []
 
     def get_usage_pieces(self, ctx: Context) -> list[str]:
+        if self.metavar is None and not self.required:
+            var = self.type.get_metavar(param=self, ctx=ctx)
+
+            # The type already brackets its metavar, like Choice and DateTime
+            # do. Let those brackets mark the argument as optional instead of
+            # wrapping it in a second pair.
+            if var and _is_bracketed(var):
+                if self.deprecated:
+                    var += "!"
+                if self.nargs != 1:
+                    var += "..."
+                return [var]
+
         return [self.make_metavar(ctx)]
 
