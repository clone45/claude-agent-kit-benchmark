     assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
 
 
+@pytest.mark.parametrize(
+    ("type", "kwargs", "expected"),
+    [
+        (click.Choice(["foo", "bar", "baz"]), {}, "{foo|bar|baz}"),
+        (click.Choice(["foo", "bar", "baz"]), {"nargs": 2}, "{foo|bar|baz}..."),
+        (click.Choice(["foo", "bar", "baz"]), {"required": False}, "[foo|bar|baz]"),
+        (click.Choice(["foo", "bar", "baz"]), {"default": "foo"}, "[foo|bar|baz]"),
+        (click.Choice(["foo", "bar", "baz"]), {"nargs": -1}, "[foo|bar|baz]..."),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"nargs": 2, "required": False},
+            "[foo|bar|baz]...",
+        ),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"required": False, "deprecated": True},
+            "[foo|bar|baz]!",
+        ),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"nargs": -1, "deprecated": True},
+            "[foo|bar|baz]!...",
+        ),
+        (click.DateTime(formats=["%Y-%m-%d"]), {}, "[%Y-%m-%d]"),
+        (click.DateTime(formats=["%Y-%m-%d"]), {"required": False}, "[%Y-%m-%d]"),
+        (click.DateTime(formats=["%Y-%m-%d"]), {"nargs": -1}, "[%Y-%m-%d]..."),
+        (click.STRING, {"metavar": "[X]", "required": False}, "[X]"),
+    ],
+)
+def test_argument_type_brackets_mark_optional(runner, type, kwargs, expected):
+    """A type that already brackets its metavar is not bracketed a second time
+    in the usage line when the argument is optional.
+    """
+
+    @click.command()
+    @click.argument("foo", type=type, **kwargs)
+    def cli(foo):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
+
+
+@pytest.mark.parametrize(
+    ("metavar", "expected"),
+    [
+        ("[a|b]", "[a|b]"),
+        ("[a]|[b]", "[[a]|[b]]"),
+        ("[[a]|[b]]", "[[a]|[b]]"),
+        ("[a", "[[a]"),
+        ("a]", "[a]]"),
+        ("A", "[A]"),
+    ],
+)
+def test_argument_type_brackets_whole_metavar(runner, metavar, expected):
+    """Only a metavar enclosed by a single pair of brackets counts as already
+    bracketed.
+    """
+
+    class Bracketed(click.ParamType):
+        name = "bracketed"
+
+        def get_metavar(self, param, ctx):
+            return metavar
+
+    @click.command()
+    @click.argument("foo", type=Bracketed(), required=False)
+    def cli(foo):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.exit_code == 0, result.output
+    assert result.output.splitlines()[0] == f"Usage: cli [OPTIONS] {expected}"
+
+
 @pytest.mark.parametrize(
     ("deprecated", "expected_label"),
     [(True, "(DEPRECATED)"), ("use g instead", "(DEPRECATED: use g instead)")],
