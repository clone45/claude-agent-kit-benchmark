@@ -3891,6 +3891,23 @@ class Option(Parameter):
         return super().process_value(ctx, value)
 
 
+def _is_bracketed(value: str) -> bool:
+    """Whether ``value`` is entirely enclosed by one pair of square brackets,
+    so the leading ``[`` pairs with the trailing ``]``. ``[a]|[b]`` is not.
+    """
+    if not (value.startswith("[") and value.endswith("]")):
+        return False
+    depth = 0
+    for i, char in enumerate(value):
+        if char == "[":
+            depth += 1
+        elif char == "]":
+            depth -= 1
+            if depth == 0:
+                return i == len(value) - 1
+    return False
+
