+@pytest.mark.parametrize(
+    ("type", "kwargs", "expected"),
+    [
+        (click.Choice(["foo", "bar", "baz"]), {"nargs": -1}, "[foo|bar|baz]..."),
+        (click.Choice(["foo", "bar", "baz"]), {"required": False}, "[foo|bar|baz]"),
+        (click.Choice(["foo", "bar", "baz"]), {"required": True}, "{foo|bar|baz}"),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"nargs": -1, "required": True},
+            "{foo|bar|baz}...",
+        ),
+        (
+            click.Choice(["foo", "bar", "baz"]),
+            {"required": False, "deprecated": True},
+            "[foo|bar|baz]!",
+        ),
+        (click.DateTime(formats=["%Y-%m-%d"]), {"required": False}, "[%Y-%m-%d]"),
+        (click.DateTime(formats=["%Y-%m-%d"]), {"nargs": -1}, "[%Y-%m-%d]..."),
+        (click.DateTime(formats=["%Y-%m-%d"]), {"required": True}, "[%Y-%m-%d]"),
+        (click.DateTime(formats=["%Y-%m-%d"]), {"nargs": 2}, "[%Y-%m-%d]..."),
+    ],
+)
+def test_bracketed_type_argument_usage(runner, type, kwargs, expected):
+    """A type that already brackets its metavar, like ``Choice`` or
+    ``DateTime``, supplies the optional marker itself instead of getting a
+    second pair, which used to render as ``[[foo|bar|baz]]``.
+    """
+
+    @click.command()
+    @click.argument("value", type=type, **kwargs)
+    def cli(value):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.output.startswith(f"Usage: cli [OPTIONS] {expected}\n")
+    assert "[[" not in result.output
+
+
+class _PairedBracketsType(click.ParamType):
+    name = "paired"
+
+    def get_metavar(self, param, ctx):
+        return "[a]|[b]"
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "expected"),
+    [
+        ({"required": False}, "[[a]|[b]]"),
+        ({"nargs": -1}, "[[a]|[b]]..."),
+        ({"required": True}, "[a]|[b]"),
+    ],
+)
+def test_partially_bracketed_type_argument_usage(runner, kwargs, expected):
+    """A metavar that starts and ends with brackets that are not one enclosing
+    pair still gets the optional marker.
+    """
+
+    @click.command()
+    @click.argument("value", type=_PairedBracketsType(), **kwargs)
+    def cli(value):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert result.output.startswith(f"Usage: cli [OPTIONS] {expected}\n")
+
+
